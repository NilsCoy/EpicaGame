func greedy_mesh(st: SurfaceTool):

	var dims = [CHUNK_SIZE, CHUNK_SIZE, CHUNK_SIZE]
	var mask = []

	for d in 3:

		var u = (d + 1) % 3
		var v = (d + 2) % 3

		var q = Vector3i()
		q[d] = 1

		for id in range(-1, dims[d]):
			var x = Vector3i()
			x[d] = id
			# Строим маску
			mask.clear()

			for iv in dims[v]:
				for iu in dims[u]:
					
					x[v] = iv
					x[u] = iu
					
					var a = false
					var b = false

					if x[d] >= 0:
						a = get_block_vec(x)

					if x[d] < dims[d] - 1:
						b = get_block_vec(x + q)

					if a != b:
						mask.append(a)
					else:
						mask.append(null)

			x[d] += 1

			# Greedy 2D
			var n = 0
			for j in dims[v]:
				var i = 0
				while i < dims[u]:
					if mask[n] != null:
						var w = 1
						while i + w < dims[u] and mask[n + w] == mask[n]:
							w += 1

						var h = 1
						var done = false
						while j + h < dims[v]:
							for k in w:
								if mask[n + k + h * dims[u]] != mask[n]:
									done = true
									break
							if done:
								break
							h += 1

						# Добавляем quad
						x[u] = i
						x[v] = j

						var du = Vector3i()
						var dv = Vector3i()
						du[u] = w
						dv[v] = h

						add_quad(st, x, du, dv, d, mask[n])

						# очищаем маску
						for l in h:
							for k in w:
								mask[n + k + l * dims[u]] = null

						i += w
						n += w

					else:
						i += 1
						n += 1

func add_quad(st, x, du, dv, d, filled):

	var normal = Vector3()
	normal[d] = 1 if filled else -1

	var p = Vector3(x)

	var v1 = p
	var v2 = p + Vector3(du)
	var v3 = p + Vector3(du) + Vector3(dv)
	var v4 = p + Vector3(dv)

	if normal[d] < 0:
		var tmp = v1
		v1 = v2
		v2 = tmp

		tmp = v3
		v3 = v4
		v4 = tmp

	# triangle 1
	st.set_normal(normal)
	st.add_vertex(v1)
	st.set_normal(normal)
	st.add_vertex(v2)
	st.set_normal(normal)
	st.add_vertex(v3)

	# triangle 2
	st.set_normal(normal)
	st.add_vertex(v1)
	st.set_normal(normal)
	st.add_vertex(v3)
	st.add_vertex(v4)

func get_block_vec(v: Vector3i) -> bool:
	if v.x < 0 or v.y < 0 or v.z < 0:
		return false
	if v.x >= CHUNK_SIZE or v.y >= CHUNK_SIZE or v.z >= CHUNK_SIZE:
		return false
	return blocks[v.x][v.y][v.z]
"

