[sub_resource type="GDScript" id="GDScript_c4arg"]
script/source = "extends Control

@onready var chat_history: RichTextLabel = $ChatHistory

func _on_send_chat_text_submitted(new_text: String) -> void:
	var from: Node = get_parent().get_parent()
	if new_text != '':
		ChatManager.send(from, new_text)
		$SendChat.text = ''

func add_text(text: String) -> void:
	chat_history.text += text + \"\\n\"
"

