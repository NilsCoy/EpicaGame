[sub_resource type="GDScript" id="GDScript_s1fef"]
script/source = "extends CanvasLayer

@onready var world_edit_ui: Control = $WorldEdit_UI
@onready var player_inventory: InventoryWindow = $PlayerInventory
@onready var creative_inventory: InventoryWindow = $CreativeInventory
@onready var chat: Control = $Chat
@onready var hud: Control = $HUD


func _ready() -> void:
	close_all_windows()
	world_edit_ui.connect_to_parent(get_parent())
	get_parent().current_block_update.connect(creative_inventory._current_block_update)

func _process(delta: float) -> void:
	if get_multiplayer_authority() != multiplayer.get_unique_id():
		return
	
	if Input.is_action_just_pressed(\"esc\"):
		if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
			Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
			close_all_windows()
		else:
			Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
			close_all_windows()
	
	if Input.is_action_just_pressed(\"tab\"):
		match get_parent().gamemode:
			0, 1:
				if $PlayerInventory.visible == false:
					Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
					open_window(\"PlayerInventory\")
				else:
					Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
					close_all_windows()
			2:
				if $CreativeInventory/ScrollContainer.visible == false:
					Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
					open_window(\"CreativeInventory\")
				else:
					Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
					close_all_windows()
	
	if Input.is_action_just_pressed(\"chat\") and get_parent().gamemode != 2:
		if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
			Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
			open_window(\"Chat\")
		else:
			Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
			close_all_windows()
	
	

func close_all_windows() -> void:
	$Background.hide()
	$PlayerInventory.hide()
	$CreativeInventory/ScrollContainer.hide()
	$Chat/BackgroundRect.hide()
	$Chat/SendChat.release_focus()
	world_edit_ui.hide()

func open_window(window_name: String) -> void:
	close_all_windows()
	match window_name:
		\"PlayerInventory\":
			$PlayerInventory.show()
			$Background.show()
		\"CreativeInventory\":
			$CreativeInventory/ScrollContainer.show()
			$Background.show()
		\"Chat\":
			chat.show()
			$Chat/BackgroundRect.show()
			$Chat/SendChat.grab_focus()
		\"WorldEdit\":
			chat.hide()
			world_edit_ui.show()
"

[sub_resource type="GDScript" id="GDScript_2hnfo"]
script/source = "extends Label

func _process(delta: float) -> void:
	text = str(int(Performance.get_monitor(Performance.TIME_FPS)))
"

[sub_resource type="GDScript" id="GDScript_we3k3"]
script/source = "extends Control

func update_nickname(nickname: String) -> void:
	$NicknameLable.text = nickname

func update_health(health: float, max_health: float) -> void:
	$HealthLable.text = str(int(health))+'%'
	$HealthBar.max_value = max_health
	$HealthBar.value = health

func update_energy(energy: float, max_energy: float) -> void:
	$EnergyLable.text = str(int(energy))+'%'
	$EnergyBar.max_value = max_energy
	$EnergyBar.value = energy
"

[sub_resource type="GDScript" id="GDScript_plo7s"]
script/source = "extends Control

func _ready() -> void:
	$HeadTexture.texture = get_texture_3d()

func get_texture_3d() -> AtlasTexture:
	var texture: AtlasTexture = AtlasTexture.new()
	texture.atlas = $HeadScreen.get_texture()
	return texture
"

[sub_resource type="Environment" id="Environment_3smsa"]

[sub_resource type="World3D" id="World3D_8erm5"]
