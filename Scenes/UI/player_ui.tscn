[sub_resource type="GDScript" id="GDScript_vgqql"]
script/source = "extends Control

# Inventory
@export var blocks_data: InventoryData
@export var hot_bar_data: InventoryData
var grabbed_slot_data: SlotData
@onready var grabbed_slot_container: Control = $GrabbedSlotContainer

func _ready() -> void:
	var files: Array = SaveManager.get_files_in_directory('Resources/Blocks/Data/')
	for file: String in files:
		var slot: SlotData = SlotData.new()
		var item: ItemData = ItemData.new()
		item.name = file.split(\".\")[0]
		var block: Dictionary = SaveManager.read_json(SaveManager.get_file_path('Resources/Blocks/Data/'+file, true))
		if block[\"type\"] == \"block\":
			var atlas_texture: Texture2D = load(block[\"textures\"][\"side\"])
			var texture: AtlasTexture = AtlasTexture.new()
			texture.atlas = atlas_texture
			item.texture = texture
		elif block[\"type\"] == \"model\":
			item.texture = get_texture_3d(block[\"asset\"])
		item.attributes[\"action\"] = \"block\"
		item.max_stack = 99
		slot.item_data = item
		slot.quantity = item.max_stack
		blocks_data.slot_datas.append(slot)
	blocks_data.inventory_interact.connect(on_inventory_interact)
	$ScrollContainer/BlocksContainer.set_inventory_data(blocks_data)
	hot_bar_data.inventory_interact.connect(on_inventory_interact)
	$HotBarContainer.set_inventory_data(hot_bar_data)

func _physics_process(delta: float) -> void:
	if grabbed_slot_container.visible:
		grabbed_slot_container.global_position = get_global_mouse_position() + Vector2(5, 5)

func get_texture_3d(path: String) -> AtlasTexture:
	for i: Node in $BlockScreen/Scene.get_children():
		i.free()
	var node: Variant = load(path).instantiate()
	$BlockScreen/Scene.add_child(node)
	var texture: AtlasTexture = AtlasTexture.new()
	texture.atlas = $BlockScreen.get_texture()
	return texture

func on_inventory_interact(inventory_data: InventoryData, index: int, button: int) -> void:
	if Input.is_action_pressed(\"shift\"):
		if inventory_data.inv_name == \"ItemTabs\":
			inventory_data.transportation_slot_data(index, hot_bar_data)
		elif inventory_data.inv_name == \"HotBar\":
			inventory_data.transportation_slot_data(index, blocks_data)
	else:
		match [grabbed_slot_data, button]:
			[null, MOUSE_BUTTON_LEFT]:
					grabbed_slot_data = inventory_data.grab_slot_data(index)
			[_, MOUSE_BUTTON_LEFT]:
				grabbed_slot_data = inventory_data.drop_slot_data(grabbed_slot_data, index)
			[null, MOUSE_BUTTON_RIGHT]:
				grabbed_slot_data = inventory_data.grab_hafl_slot_data(index)
			[_, MOUSE_BUTTON_RIGHT]:
				grabbed_slot_data = inventory_data.drop_single_slot_data(grabbed_slot_data, index)
	update_grabbed_slot()

func update_grabbed_slot() -> void:
	if grabbed_slot_data:
		grabbed_slot_container.set_slot_data(grabbed_slot_data)
		grabbed_slot_container.show()
	else: grabbed_slot_container.hide()
"

