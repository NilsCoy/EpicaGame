[sub_resource type="GDScript" id="GDScript_14y0q"]
script/source = "extends Control

var current_block: String = \"\"
var parent: Node

var selected_tool: String:
	get():
		if rectangle_select.content.window_visible:
			var tool_data: Dictionary = rectangle_select.get_tool()
			return tool_data['tool_type']
		elif sphere.content.window_visible:
			var tool_data: Dictionary = sphere.get_tool()
			return tool_data['tool_type']
		elif cylinder.content.window_visible:
			var tool_data: Dictionary = cylinder.get_tool()
			return tool_data['tool_type']
		elif cube.content.window_visible:
			var tool_data: Dictionary = cube.get_tool()
			return tool_data['tool_type']
		elif smooth.content.window_visible:
			var tool_data: Dictionary = smooth.get_tool()
			return tool_data['tool_type']
		return ''

@onready var block_id: HBoxContainer = $ToolContainer/MarginContainer/ScrollContainer/MainContainer/BlockID
@onready var block_x: HBoxContainer = $ToolContainer/MarginContainer/ScrollContainer/MainContainer/BlockPosContainer/BlockX
@onready var block_y: HBoxContainer = $ToolContainer/MarginContainer/ScrollContainer/MainContainer/BlockPosContainer/BlockY
@onready var block_z: HBoxContainer = $ToolContainer/MarginContainer/ScrollContainer/MainContainer/BlockPosContainer/BlockZ

@onready var rectangle_select: ToolPanel = $ToolContainer/MarginContainer/ScrollContainer/MainContainer/RectangleSelect
@onready var poly_select: ToolPanel = $ToolContainer/MarginContainer/ScrollContainer/MainContainer/PolySelect

@onready var sphere: PanelContainer = $ToolContainer/MarginContainer/ScrollContainer/MainContainer/Sphere
@onready var cylinder: PanelContainer = $ToolContainer/MarginContainer/ScrollContainer/MainContainer/Cylinder
@onready var cube: PanelContainer = $ToolContainer/MarginContainer/ScrollContainer/MainContainer/Cube
@onready var smooth: PanelContainer = $ToolContainer/MarginContainer/ScrollContainer/MainContainer/Smooth


func _physics_process(delta: float) -> void:
	if visible:
		if Input.is_action_just_pressed('alt'):
			if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
				Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
			else:
				Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
		
		if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
			if Input.is_action_just_pressed('left_click'): _apply_tool('left')
			elif Input.is_action_just_pressed('right_click'): _apply_tool('right')

func connect_to_parent(p: Node) -> void:
	parent = p
	parent.current_block_update.connect(_current_block_update)
	block_id.change_value.connect(_change_value)

func _change_value(value: String) -> void:
	current_block = value

func _current_block_update(value: String) -> void:
	#current_block = value
	block_id.value = value

func _apply_tool(mouse_button: String) -> void:
	if selected_tool == 'rectangle_select':
		var tool_data: Dictionary = rectangle_select.get_tool()
		if parent._get_select_block_on_global_pos() != Vector3.INF and parent._get_select_block_pos() != null:
			var hit: Vector3i = parent._get_select_block_pos()
			var pos: Vector3 = parent._get_select_block_on_global_pos()
			if mouse_button == 'left':
				rectangle_select.block_x1.value = str(hit.x)
				rectangle_select.block_y1.value = str(hit.y)
				rectangle_select.block_z1.value = str(hit.z)
				WorldEdit.overlay.block_pos_1_overlay.global_position = pos
				WorldEdit.overlay.block_pos_1_visible = true
			elif mouse_button == 'right':
				rectangle_select.block_x2.value = str(hit.x)
				rectangle_select.block_y2.value = str(hit.y)
				rectangle_select.block_z2.value = str(hit.z)
				WorldEdit.overlay.block_pos_2_overlay.global_position = pos
				WorldEdit.overlay.block_pos_2_visible = true
			#WorldEdit.sphere(hit, tool_data.get('radius', 5), current_block,
				#tool_data.get('hollow', false), tool_data.get('thickness', 1))
	if selected_tool == 'sphere':
		var tool_data: Dictionary = sphere.get_tool()
		if parent._get_select_block_pos() != null and current_block != '':
			var hit: Vector3i = parent._get_select_block_pos()
			block_x.value = str(hit.x)
			block_y.value = str(hit.y)
			block_z.value = str(hit.z)
			WorldEdit.sphere(hit, tool_data.get('radius', 5), current_block,
				tool_data.get('hollow', false), tool_data.get('thickness', 1))
	if selected_tool == 'cylinder':
		var tool_data: Dictionary = cylinder.get_tool()
		if parent._get_select_block_pos() != null and current_block != '':
			var hit: Vector3i = parent._get_select_block_pos()
			block_x.value = str(hit.x)
			block_y.value = str(hit.y)
			block_z.value = str(hit.z)
			WorldEdit.cylinder(hit, tool_data.get('radius', 5), tool_data.get('height', 5),
				current_block, tool_data.get('hollow', false), tool_data.get('thickness', 1))
	if selected_tool == 'cube':
		var tool_data: Dictionary = cube.get_tool()
		if parent._get_select_block_pos() != null and current_block != '':
			var hit: Vector3i = parent._get_select_block_pos()
			block_x.value = str(hit.x)
			block_y.value = str(hit.y)
			block_z.value = str(hit.z)
			WorldEdit.cube_radius_height(hit, tool_data.get('radius', 5), tool_data.get('height', 5),
					current_block, tool_data.get('hollow', false), tool_data.get('thickness', 1))
	if selected_tool == 'smooth':
		var tool_data: Dictionary = smooth.get_tool()
		if parent._get_select_block_pos() != null and current_block != '':
			var hit: Vector3i = parent._get_select_block_pos()
			block_x.value = str(hit.x)
			block_y.value = str(hit.y)
			block_z.value = str(hit.z)
			WorldEdit.smooth_cylinder(hit, tool_data.get('radius', 5), tool_data.get('height', 5),
				tool_data.get('strength', 1))
"

[sub_resource type="GDScript" id="GDScript_8e154"]
script/source = "extends ToolPanel

@onready var content: VBoxContainer = $DropdownContent

@onready var block_x1: LableEdit = $DropdownContent/BlockPos1/BlockX
@onready var block_y1: LableEdit = $DropdownContent/BlockPos1/BlockY
@onready var block_z1: LableEdit = $DropdownContent/BlockPos1/BlockZ

@onready var block_x2: LableEdit = $DropdownContent/BlockPos2/BlockX
@onready var block_y2: LableEdit = $DropdownContent/BlockPos2/BlockY
@onready var block_z2: LableEdit = $DropdownContent/BlockPos2/BlockZ

func get_tool() -> Dictionary:
	var tool_data: Dictionary
	
	tool_data['tool_type'] = tool_type
	
	tool_data['block_x1'] = int(block_x1.value)
	tool_data['block_y1'] = int(block_y1.value)
	tool_data['block_z1'] = int(block_z1.value)
	
	tool_data['block_x2'] = int(block_x2.value)
	tool_data['block_y2'] = int(block_y2.value)
	tool_data['block_z2'] = int(block_z2.value)
	
	return tool_data
"

