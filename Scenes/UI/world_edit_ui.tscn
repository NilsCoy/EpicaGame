[sub_resource type="GDScript" id="GDScript_33kp7"]
script/source = "extends HBoxContainer

var id: int

signal delete_position(id:int)

func _on_delete_button_pressed() -> void:
	delete_position.emit(id)
	queue_free()
"

[sub_resource type="GDScript" id="GDScript_jjus3"]
script/source = "extends ToolPanel

@onready var content: VBoxContainer = $DropdownContent

@onready var raduis: HBoxContainer = $DropdownContent/Raduis
@onready var hollow_button: CheckButton = $DropdownContent/DropdownContent/HollowButton
@onready var thickness: HBoxContainer = $DropdownContent/DropdownContent/Thickness

func get_tool() -> Dictionary:
	var tool_data: Dictionary
	
	tool_data['tool_type'] = tool_type
	tool_data['radius'] = int(raduis.value)
	tool_data['hollow'] = hollow_button.button_pressed
	tool_data['thickness'] = int(thickness.value)
	
	return tool_data
"

