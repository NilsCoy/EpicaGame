[sub_resource type="GDScript" id="GDScript_14y0q"]
script/source = "extends Control

var current_block: String = \"\"
var parent: Node

@onready var block_id: HBoxContainer = $PanelContainer/MarginContainer/ScrollContainer/MainContainer/BlockID
@onready var block_x: HBoxContainer = $PanelContainer/MarginContainer/ScrollContainer/MainContainer/HBoxContainer/BlockX
@onready var block_y: HBoxContainer = $PanelContainer/MarginContainer/ScrollContainer/MainContainer/HBoxContainer/BlockY
@onready var block_z: HBoxContainer = $PanelContainer/MarginContainer/ScrollContainer/MainContainer/HBoxContainer/BlockZ

@onready var sphere: PanelContainer = $PanelContainer/MarginContainer/ScrollContainer/MainContainer/Sphere

func _physics_process(delta: float) -> void:
	if visible:
		if Input.is_action_just_pressed('alt'):
			if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
				Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
			else:
				Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
		
		if Input.is_action_just_pressed('right_click') and if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
			_apply_tool()

func connect_to_parent(p: Node) -> void:
	parent = p
	parent.current_block_update.connect(_current_block_update)

func _current_block_update(value: String) -> void:
	current_block = value

func _apply_tool() -> void:
	if sphere.content.window_visible:
		var tool_data: Dictionary = sphere.get_tool()
		var hit: Vector3i = parent._get_select_block_pos()
		if parent._get_select_block_pos() != null and current_block != '':
			WorldEdit.sphere(hit, tool_data['radius'], current_block, tool_data['hollow'], tool_data['thickness'])
"

[sub_resource type="GDScript" id="GDScript_jjus3"]
script/source = "extends PanelContainer

@export var tool_type: String = 'sphere'

@onready var content: VBoxContainer = $DropdownContent

@onready var raduis: HBoxContainer = $DropdownContent/Raduis
@onready var hollow_button: CheckButton = $DropdownContent/DropdownContent/HollowButton
@onready var thickness: HBoxContainer = $DropdownContent/DropdownContent/Thickness

func get_tool() -> Dictionary:
	var tool_data: Dictionary
	
	tool_data['tool_type'] = tool_type
	tool_data['radius'] = int(raduis.value)
	tool_data['hollow'] = hollow_button.button_pressed
	tool_data['thickness'] = int(thickness.value)
	
	return tool_data
"

