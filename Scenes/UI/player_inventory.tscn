[sub_resource type="GDScript" id="GDScript_47rqh"]
script/source = "extends PanelContainer

const Slot: Resource = preload(\"res://Scenes/InventorySystem/multi_slot_container.tscn\")
const ItemVisual: Resource = preload(\"res://Scenes/InventorySystem/item_visual.tscn\")

@onready var item_area: Control = $ItemArea


func set_inventory_data(inventory_data: InventoryData) -> void:
	inventory_data.init_inventory()
	inventory_data.inventory_update.connect(populate_item_grid)
	populate_item_grid(inventory_data)

func populate_item_grid(inventory_data: InventoryData) -> void:
	var index: int = 0
	for child: Node in item_area.get_children():
		child.clear_slot_data()
		
		if not(child.slot_clicked.is_connected(inventory_data.on_slot_clicked)):
			child.slot_clicked.connect(inventory_data.on_slot_clicked)
		
		var slot_data: SlotData = inventory_data.slot_datas[index]
		if slot_data != null:
			child.set_slot_data(slot_data)

		index += 1
"

