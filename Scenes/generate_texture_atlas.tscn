[gd_scene format=3 uid="uid://cd36x2mlp1cj2"]

[sub_resource type="GDScript" id="GDScript_fxl7y"]
script/source = "extends Node

@export var block_texture_paths: Array[String] = [
	\"res://Assets/Blocks/dirt.png\",
	\"res://Assets/Blocks/stone.png\",
]

var atlas_texture: Texture2D
var block_uv_map = {}

var ATLAS_SIZE = 0
var TILE_SIZE = 0.0

func _ready():
	generate_texture_atlas()

func generate_texture_atlas():
	if block_texture_paths.is_empty():
		push_error(\"Нет текстур для атласа\")
		return

	# Загружаем первую текстуру чтобы узнать размер
	var first_tex: Texture2D = load(block_texture_paths[0])
	var tile_px_size = first_tex.get_width()

	var texture_count = block_texture_paths.size()
	ATLAS_SIZE = int(ceil(sqrt(texture_count)))
	TILE_SIZE = 1.0 / ATLAS_SIZE

	var atlas_px_size = ATLAS_SIZE * tile_px_size

	var atlas_image = Image.create(atlas_px_size, atlas_px_size, false, Image.FORMAT_RGBA8)
	atlas_image.fill(Color(0,0,0,0))

	for i in texture_count:
		var tex: Texture2D = load(block_texture_paths[i])
		var img: Image = tex.get_image()
		
		if img.is_compressed():
			img.decompress()

		if img.get_format() != Image.FORMAT_RGBA8:
			img.convert(Image.FORMAT_RGBA8)

		var x = i % ATLAS_SIZE
		var y = i / ATLAS_SIZE

		atlas_image.blit_rect(
			img,
			Rect2i(0, 0, tile_px_size, tile_px_size),
			Vector2i(x * tile_px_size, y * tile_px_size)
		)

		# block_id начинается с 1
		block_uv_map[i + 1] = Vector2i(x, y)

	atlas_texture = ImageTexture.create_from_image(atlas_image)
"

