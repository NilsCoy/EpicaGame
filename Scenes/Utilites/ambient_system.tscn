[gd_scene format=3 uid="uid://csirajce688aq"]

[sub_resource type="GDScript" id="GDScript_rmxbf"]
script/source = "extends Node

var num_sound: int
@onready var audio_stream_player: AudioStreamPlayer = $AudioStreamPlayer
@onready var animation_player: AnimationPlayer = $AnimationPlayer

@export var sounds: Array[String] = [
	\"res://Assets/Music/Ambient/additional_bonuses.ogg\",
	\"res://Assets/Music/Ambient/an_arts_score.ogg\",
	\"res://Assets/Music/Ambient/a_side_effect.ogg\",
	\"res://Assets/Music/Ambient/the_large_catalog.ogg\",
	]

func init_sound() -> void:
	num_sound = randi_range(0, len(sounds)-1)
	animation_player.play_backwards(\"SoundFade\")
	play_sound(sounds[num_sound])

func next_sound() -> void:
	num_sound = wrap(num_sound, 0, len(sounds)-1)
	play_sound(sounds[num_sound])

func play_sound(path: String) -> void:
	var sound: AudioStream = load(path)
	audio_stream_player.stream = sound
	audio_stream_player.play()

func start_sound() -> void:
	audio_stream_player.stream_paused = false
	animation_player.play_backwards(\"SoundFade\")

func stop_sound() -> void:
	animation_player.play(\"SoundFade\")
	await get_tree().create_timer(2).timeout
	audio_stream_player.stream_paused = true

func _on_audio_stream_player_finished() -> void:
	next_sound()
"

