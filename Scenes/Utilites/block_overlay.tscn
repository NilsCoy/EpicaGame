[gd_scene format=3 uid="uid://cmc1j85jbtktt"]

[ext_resource type="Shader" uid="uid://cj2wtjajfu6jr" path="res://Scripts/Shaders/block_overlay.gdshader" id="1_wkq2a"]

[sub_resource type="GDScript" id="GDScript_kvkok"]
script/source = "extends Node

@export var block_look_visible: bool = false:
	set(new_value):
		block_look_visible = new_value
		block_look_overlay.visible = new_value

@export var block_pos_1_visible: bool = false:
	set(new_value):
		block_pos_1_visible = new_value
		block_pos_1_overlay.visible = new_value
		update_area_overlay()

@export var block_pos_2_visible: bool = false:
	set(new_value):
		block_pos_2_visible = new_value
		block_pos_2_overlay.visible = new_value
		update_area_overlay()

@export var block_area_visible: bool = false:
	set(new_value):
		block_area_visible = new_value
		block_area_overlay.visible = new_value

@onready var block_look_overlay: MeshInstance3D = $BlockLookOverlay
@onready var block_pos_1_overlay: MeshInstance3D = $BlockPos1Overlay
@onready var block_pos_2_overlay: MeshInstance3D = $BlockPos2Overlay
@onready var block_area_overlay: MeshInstance3D = $BlockAreaOverlay

## Размер одной блочной клетки по всем осям.
const BLOCK_SIZE: float = 1.0

## Возвращает блочную координату (int) объекта block_pos_1_overlay и сохраняет её в point_1.
var point_1: Vector3i:
	get():
		return _node_position_to_block(block_pos_1_overlay)
## Возвращает блочную координату (int) объекта block_pos_2_overlay и сохраняет её в point_2.
var point_2: Vector3i:
	get():
		return _node_position_to_block(block_pos_2_overlay)

## Обновляет block_area_overlay: масштаб и позицию так, чтобы он покрывал область от point_1 до point_2.
func update_area_overlay() -> void:
	if block_pos_1_visible and block_pos_2_visible:
		block_area_visible = true

	# Границы области в блочных координатах (включительно).
	var min_block: Vector3i = Vector3i(
		mini(point_1.x, point_2.x),
		mini(point_1.y, point_2.y),
		mini(point_1.z, point_2.z)
	)
	var max_block: Vector3i = Vector3i(
		maxi(point_1.x, point_2.x),
		maxi(point_1.y, point_2.y),
		maxi(point_1.z, point_2.z)
	)

	# Размер области в блоках (минимум 1 по каждой оси).
	var block_size: Vector3i = Vector3i(
		max_block.x - min_block.x + 1,
		max_block.y - min_block.y + 1,
		max_block.z - min_block.z + 1
	)

	# Масштаб: предполагаем, что базовый меш area_overlay — куб 1x1x1.
	block_area_overlay.scale = Vector3(
		block_size.x * BLOCK_SIZE + 0.1,
		block_size.y * BLOCK_SIZE + 0.1,
		block_size.z * BLOCK_SIZE + 0.1
	)

	# Центр области = середина между минимальной и максимальной точками.
	var area_center: Vector3 = (Vector3(min_block) + Vector3(block_size) * 0.5) * BLOCK_SIZE
	block_area_overlay.position = area_center


## Преобразует позицию ноды (оверлея точки) в блочную координату.
## Оверлей точки стоит в центре клетки, поэтому сначала смещаем на полблока назад.
func _node_position_to_block(node: Node3D) -> Vector3i:
	if node == null:
		return Vector3i.ZERO
	var block_position: Vector3 = node.position / BLOCK_SIZE - Vector3.ONE * 0.5
	return Vector3i(
		floori(block_position.x),
		floori(block_position.y),
		floori(block_position.z)
	)
"

