[gd_scene format=3 uid="uid://cm4jgqdf45be"]

[sub_resource type="GDScript" id="GDScript_eft0f"]
script/source = "extends Node3D

@export var parent: Node

## Текстура предмета
@export var texture: Texture2D
## Размер пикселей в 3д
@export var pixel_size: float = 0.05
## Глубина пикселей в 3д
@export var depth: float = 0.05
## Смещение объекта
@export var pivot: Vector2 = Vector2(8.0, 20.0)

## Размер бокса колизии
@export var collision_size: Vector3 = Vector3(0.3, 0.8, 0.3)
## Смещение бокса колизии
@export var collision_offset: Vector3 = Vector3(0, 0.6, 0)

## Время начала атаки (начало хитскана)
@export var start_attack: float = 0.5
## Время конца атаки (длина хитскана)
@export var end_attack: float = 0.5

@onready var area: Area3D = $Area3D
@onready var collision_shape: CollisionShape3D = $Area3D/CollisionShape3D
@onready var start_timer: Timer = $Area3D/StartTimer
@onready var end_timer: Timer = $Area3D/EndTimer
@onready var cubes: Node3D = $Cubes
var attacked: Array

func _ready() -> void:
	if not(OS.has_feature(\"dedicated_server\")):
		rebuild()

## Перестраивает модель предмета
func rebuild() -> void:
	var shape: BoxShape3D = BoxShape3D.new()
	shape.size = collision_size
	collision_shape.shape = shape

	collision_shape.position = collision_offset
	
	start_timer.wait_time = start_attack
	end_timer.wait_time = end_attack

	cubes.clear_cubes()

	# Выделенному серверу нужна только коллизия, текстур на нем нет
	if OS.has_feature(\"dedicated_server\") or texture == null:
		return
	var image: Image = texture.get_image()
	if image == null:
		return

	for x: int in image.get_width():
		for y: int in image.get_height():
			var color: Color = image.get_pixel(x, y)

			# Пропускаем прозрачные пиксели
			if color.a < 0.1:
				continue

			var cube: MeshInstance3D = MeshInstance3D.new()
			cube.mesh = BoxMesh.new()
			cube.scale = Vector3(pixel_size, pixel_size, depth)

			var material: StandardMaterial3D = StandardMaterial3D.new()
			material.albedo_color = color
			cube.material_override = material

			var local_x: float = (x - pivot.x) * pixel_size
			var local_y: float = (y - pivot.y) * pixel_size

			cube.position = Vector3(
				local_x,
				-local_y,
				0
			)

			cubes.add_child(cube)

func _on_area_3d_body_entered(body: Node3D) -> void:
	if body.has_node(\"ComponentContainer\"):
		var component: HealthEntityComponent = body.get_node('ComponentContainer').get_component('HealthEntityComponent')
		#var body_id: int = body.get_multiplayer_authority()
		var body_name: String = body.name
		if component != null:
			if body != parent:
				if not body_name in attacked:
					attacked.append(body_name)
					component.rpc('damage', parent.save_data(), 50)

func _on_start_timer_timeout() -> void:
	#$Area3D.monitoring = true
	$Area3D/CollisionShape3D.disabled = false
	end_timer.start()

func _on_end_timer_timeout() -> void:
	#$Area3D.monitoring = false
	$Area3D/CollisionShape3D.disabled = true

func attack() -> void:
	attacked = []
	start_timer.start()
"

[sub_resource type="BoxShape3D" id="BoxShape3D_eft0f"]

[sub_resource type="GDScript" id="GDScript_wc5v8"]
script/source = "extends Node

## Проверят есть ли модель предмета
func has_cubes() -> bool:
	if get_child_count() > 0:
		return true
	else: return false

## Удаляет созданную модель предмета
func clear_cubes() -> void:
	if has_cubes():
		for cube: MeshInstance3D in get_children():
			cube.queue_free()
"

