[gd_scene format=3 uid="uid://cp71jwraxlmpd"]

[sub_resource type="GDScript" id="GDScript_fpeqf"]
script/source = "extends PanelContainer

signal slot_clicked(index: int, button: int)

@export var color: Color = Color(0.0, 0.0, 0.0, 0.392)
@export var texture: AtlasTexture
@export var item_color: Color = Color(0.0, 0.0, 0.0, 0.392)

@onready var backgound_texture: TextureRect = $BackgoundTexture
@onready var backgound_color: ColorRect = $BackgoundColor

@onready var item_background_color: ColorRect = $ItemBackgroundColor
@onready var item_texture: TextureRect = $ItemTexture
@onready var quantity_label: Label = $QuantityLabel

func _ready() -> void:
	backgound_texture.texture = texture
	backgound_color.color = color
	item_background_color.color = item_color
	

func _on_gui_input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		if ((event.button_index == MOUSE_BUTTON_LEFT) \\
				or (event.button_index == MOUSE_BUTTON_RIGHT)) \\
				and (event.is_pressed()):
			slot_clicked.emit(get_index(), event.button_index)

func clear_slot_data() -> void:
	item_texture.texture = null
	tooltip_text = \"\"
	quantity_label.hide()
	item_background_color.hide()
	item_texture.hide()

func set_slot_data(slot_data: SlotData) -> void:
	item_background_color.show()
	item_texture.show()
	var item_data: ItemData = slot_data.item_data
	
	if item_data == null:
		clear_slot_data()
		return

	item_texture.texture = item_data.texture
	item_texture.offset_transform_rotation = item_data.texture_rotate
	item_texture.offset_transform_scale = Vector2(item_data.texture_scale,item_data.texture_scale)

	tooltip_text = \"%s\\n%s\" % [
		item_data.item_name,
		item_data.discription
	]

	if slot_data.quantity > 1:
		quantity_label.text = str(slot_data.quantity)
		quantity_label.show()
	else:
		quantity_label.hide()
"

