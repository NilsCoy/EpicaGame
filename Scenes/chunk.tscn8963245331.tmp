func greedy_mesh(st: SurfaceTool) -> void:
	var dims = [CHUNK_SIZE, CHUNK_SIZE, CHUNK_SIZE]
	var mask = []

	for d in 3:  # d = 0,1,2 -> X,Y,Z
		var u = (d + 1) % 3
		var v = (d + 2) % 3

		var q = Vector3i()
		q[d] = 1

		for id in range(-1, dims[d]):
			mask.clear()
			
			# строим маску для слоя
			for j_v in range(dims[v]):
				for i_u in range(dims[u]):
					var x = Vector3i()
					x[d] = id
					x[u] = i_u
					x[v] = j_v

					var a = false
					var b = false
					if id >= 0:
						a = get_block_vec(x)
					if id < dims[d] - 1:
						b = get_block_vec(x + q)

					if a != b:
						mask.append(a)
					else:
						mask.append(null)

			# greedy по 2D маске
			var n = 0
			for j_v in range(dims[v]):
				var i_u = 0
				while i_u < dims[u]:
					if mask[n] != null:
						# ширина
						var w = 1
						while i_u + w < dims[u] and mask[n + w] == mask[n]:
							w += 1

						# высота
						var h = 1
						var done = false
						while j_v + h < dims[v] and not done:
							for k_w in range(w):
								if mask[n + k_w + h * dims[u]] != mask[n]:
									done = true
									break
							if not done:
								h += 1

						# создаем quad
						var x0 = Vector3i()
						x0[d] = id + 1
						x0[u] = i_u
						x0[v] = j_v

						var du = Vector3i()
						du[u] = w
						var dv = Vector3i()
						dv[v] = h

						add_quad(st, x0, du, dv, d, mask[n])

						# очищаем маску
						for l_h in range(h):
							for k_w in range(w):
								mask[n + k_w + l_h * dims[u]] = null

						i_u += w
						n += w
					else:
						i_u += 1
						n += 1

# универсальное добавление квадов для любого направления
func add_quad(st: SurfaceTool, pos: Vector3i, du: Vector3i, dv: Vector3i, d: int, filled: bool):
	var u = (d + 1) % 3
	var v = (d + 2) % 3
	
	var p = Vector3(pos)
	var du3 = Vector3(du.x, du.y, du.z)
	var dv3 = Vector3(dv.x, dv.y, dv.z)

	var v1 = p
	var v2 = p + du3
	var v3 = p + du3 + dv3
	var v4 = p + dv3

	# нормаль всегда через cross
	var normal = (v2 - v1).cross(v4 - v1).normalized()
	if not filled:
		normal = -normal

	# triangle 1
	st.set_normal(normal)
	st.add_vertex(v1)
	st.set_normal(normal)
	st.add_vertex(v2)
	st.set_normal(normal)
	st.add_vertex(v3)

	# triangle 2
	st.set_normal(normal)
	st.add_vertex(v1)
	st.set_normal(normal)
	st.add_vertex(v3)
	st.set_normal(normal)
	st.add_vertex(v4)

func get_block_vec(v: Vector3i) -> bool:
	if v.x < 0 or v.y < 0 or v.z < 0:
		return false
	if v.x >= CHUNK_SIZE or v.y >= CHUNK_SIZE or v.z >= CHUNK_SIZE:
		return false
	return blocks[v.x][v.y][v.z]
"

