[sub_resource type="GDScript" id="GDScript_8erm5"]
script/source = "extends AnimationTree

## Тип активной анимации движения 
@export_enum('idle', 'walk', 'run', 'fast_run', 'jump', 'fall', 'crouch', 'knockdown') var move_state: String = 'idle':
	set(state):
		if move_state != state:
			move_state = state
			update_move_state(state)
## Направление движения (вперед или назад)
@export_enum('forward', 'back') var move_direction: String = 'forward':
	set(direction):
		if move_direction != direction:
			move_direction = direction
			update_move_direction(direction)
## Наклон движения
@export var move_rotate_direction: Vector2 = Vector2.ZERO:
	set(rotate_direction):
		if move_rotate_direction != rotate_direction:
			move_rotate_direction = rotate_direction
			update_move_rotate_direction(rotate_direction)
## Вооружен ли (в готовности боя) WIP
@export var armed: bool = false

func _ready() -> void:
	update_move_state(move_state)
	update_move_direction(move_direction)
	update_move_rotate_direction(move_rotate_direction)
	start_attack_animation('block_relesed')

func _physics_process(delta: float) -> void:
	if get_parent().is_on_floor():
		if move_state == 'jump':
			update_move_state('fall')

## Обновляет анимации типа движения
func update_move_state(state: String) -> void:
	#move_state = state
	self[\"parameters/move_blend_tree/move_state/transition_request\"] = move_state
	#self[\"parameters/AnimationNodeBlendTree/move_state/transition_request\"] = move_state
	#self[\"parameters/weapon_move_state/transition_request\"] = move_state
	self[\"parameters/unequip_attack_blend_tree/weapon_move_state/transition_request\"] = move_state
	self[\"parameters/fists_attack_blend_tree/weapon_move_state/transition_request\"] = move_state
	self[\"parameters/right_onehand_attack_blend_tree/weapon_move_state/transition_request\"] = move_state
	self[\"parameters/left_onehand_attack_blend_tree/weapon_move_state/transition_request\"] = move_state
	self[\"parameters/close_twohand_attack_blend_tree/weapon_move_state/transition_request\"] = move_state
	self[\"parameters/far_twohand_attack_blend_tree/weapon_move_state/transition_request\"] = move_state

## Обновляет анимации направления движения (вперед или назад)
func update_move_direction(direction: String) -> void:
	#move_direction = direction
	self[\"parameters/move_blend_tree/walk_direction/transition_request\"] = move_direction
	self[\"parameters/move_blend_tree/run_direction/transition_request\"] = move_direction
	self[\"parameters/move_blend_tree/fast_run_direction/transition_request\"] = move_direction
	#self[\"parameters/AnimationNodeBlendTree/walk_direction/transition_request\"] = move_direction
	#self[\"parameters/AnimationNodeBlendTree/run_direction/transition_request\"] = move_direction

## Обновляет анимации наклона движения
func update_move_rotate_direction(rotate_direction: Vector2) -> void:
	#move_rotate_direction = rotate_direction
	self[\"parameters/move_blend_tree/walk_rotate_direction/blend_position\"] = move_rotate_direction
	self[\"parameters/move_blend_tree/run_rotate_direction/blend_position\"] = move_rotate_direction
	self[\"parameters/move_blend_tree/fast_run_rotate_direction/blend_position\"] = move_rotate_direction
	self[\"parameters/move_blend_tree/jump_rotate_direction/blend_position\"] = move_rotate_direction
	#self[\"parameters/AnimationNodeBlendTree/walk_rotate_direction/blend_position\"] = move_rotate_direction
	#self[\"parameters/AnimationNodeBlendTree/run_rotate_direction/blend_position\"] = move_rotate_direction
	#self[\"parameters/AnimationNodeBlendTree/jump_rotate_direction/blend_position\"] = move_rotate_direction

## Обновляет анимации типа экиперовонного оружия
func update_has_armed(has: bool, type: String) -> void:
	armed = has
	#print(str(has))
	#self[\"parameters/has_weapon/transition_request\"] = str(has)
	#self[\"parameters/weapon_type/transition_request\"] = type
	if has:
		self[\"parameters/weapon_type/transition_request\"] = type
		#self[\"parameters/weapon_type/transition_request\"] = 'fists'
		#self[\"parameters/weapon_type/transition_request\"] = 'right_onehand'
		#self[\"parameters/weapon_type/transition_request\"] = 'left_onehand'
		#self[\"parameters/weapon_type/transition_request\"] = 'close_twohand'
		#self[\"parameters/weapon_type/transition_request\"] = 'far_twohand'
	else:
		self[\"parameters/weapon_type/transition_request\"] = 'unequip'

## Вызывает анимацию атаки в зависимости от типа
@rpc(\"any_peer\", \"unreliable\", \"call_local\")
func start_attack_animation(state: String) -> void:
	match state:
		'attack':
			if get_attack() == 'attack_1' and not $AttackTimer.is_stopped():
				_set_attack_state('attack_2')
				$AttackTimer.start()
			elif get_attack() == 'attack_2' and not $AttackTimer.is_stopped():
				#self[\"parameters/attack_type/transition_request\"] = 'attack_1'
				#self[\"parameters/fists_attack_blend_tree/on_attack/request\"] = AnimationNodeOneShot.ONE_SHOT_REQUEST_FIRE
				_set_attack_state('attack_1')
				$AttackTimer.start()
			else:
				_set_attack_state('attack_1')
				$AttackTimer.start()
			_do_attack()
		'vertical':
			_set_attack_state('vertical')
			_do_attack()
		'stabbing':
			_set_attack_state('stabbing')
			_do_attack()
		'tip':
			_set_attack_state('tip')
			_do_attack()
		'kick':
			_set_attack_state('kick')
			_do_attack()
		'block_pressed':
			_set_block_state(true)
			#self[\"parameters/is_block/transition_request\"] = 'true'
		'block_relesed':
			_set_block_state(false)
			#self[\"parameters/is_block/transition_request\"] = 'false'
			#move_state = 'block'

## Вызывает анимации запуска атаки
func _do_attack() -> void:
	#self[\"parameters/unequip_attack_blend_tree/on_attack/request\"] = AnimationNodeOneShot.ONE_SHOT_REQUEST_FIRE
	self[\"parameters/fists_attack_blend_tree/on_attack/request\"] = AnimationNodeOneShot.ONE_SHOT_REQUEST_FIRE
	self[\"parameters/right_onehand_attack_blend_tree/on_attack/request\"] = AnimationNodeOneShot.ONE_SHOT_REQUEST_FIRE
	self[\"parameters/left_onehand_attack_blend_tree/on_attack/request\"] = AnimationNodeOneShot.ONE_SHOT_REQUEST_FIRE
	self[\"parameters/close_twohand_attack_blend_tree/on_attack/request\"] = AnimationNodeOneShot.ONE_SHOT_REQUEST_FIRE
	self[\"parameters/far_twohand_attack_blend_tree/on_attack/request\"] = AnimationNodeOneShot.ONE_SHOT_REQUEST_FIRE

## Устанавливает типы атаки
func _set_attack_state(state: String) -> void:
	self[\"parameters/unequip_attack_blend_tree/attack_type/transition_request\"] = state
	self[\"parameters/fists_attack_blend_tree/attack_type/transition_request\"] = state
	self[\"parameters/right_onehand_attack_blend_tree/attack_type/transition_request\"] = state
	self[\"parameters/left_onehand_attack_blend_tree/attack_type/transition_request\"] = state
	self[\"parameters/close_twohand_attack_blend_tree/attack_type/transition_request\"] = state
	self[\"parameters/far_twohand_attack_blend_tree/attack_type/transition_request\"] = state

## Устанавливает активный щит
func _set_block_state(state: bool) -> void:
	#self[\"parameters/unequip_attack_blend_tree/is_block/transition_request\"] = str(state)
	self[\"parameters/fists_attack_blend_tree/is_block/transition_request\"] = str(state)
	self[\"parameters/right_onehand_attack_blend_tree/is_block/transition_request\"] = str(state)
	self[\"parameters/left_onehand_attack_blend_tree/is_block/transition_request\"] = str(state)
	self[\"parameters/close_twohand_attack_blend_tree/is_block/transition_request\"] = str(state)
	self[\"parameters/far_twohand_attack_blend_tree/is_block/transition_request\"] = str(state)

## Проверяет активность счита в анимации
func is_block() -> bool:
	var result: bool = false
	match self[\"parameters/weapon_type/current_state\"]:
		#\"unequip\":
			#if self[\"parameters/unequip_attack_blend_tree/is_block/current_state\"]: result = true
		\"fists\":
			if self[\"parameters/fists_attack_blend_tree/is_block/current_state\"] == 'true': result = true
		\"right_onehand\":
			if self[\"parameters/right_onehand_attack_blend_tree/is_block/current_state\"] == 'true': result = true
		\"left_onehand\":
			if self[\"parameters/left_onehand_attack_blend_tree/is_block/current_state\"] == 'true': result = true
		\"close_twohand\":
			if self[\"parameters/close_twohand_attack_blend_tree/is_block/current_state\"] == 'true': result = true
		\"far_twohand\":
			if self[\"parameters/far_twohand_attack_blend_tree/is_block/current_state\"] == 'true': result = true
	
	return result

## Проверяет активность атаки в анимации
func is_attack() -> bool:
	var result: bool = false
	match self[\"parameters/weapon_type/current_state\"]:
		#\"unequip\":
			#if self[\"parameters/unequip_attack_blend_tree/on_attack/active\"]: result = true
		\"fists\":
			if self[\"parameters/fists_attack_blend_tree/on_attack/active\"]: result = true
		\"right_onehand\":
			if self[\"parameters/right_onehand_attack_blend_tree/on_attack/active\"]: result = true
		\"left_onehand\":
			if self[\"parameters/left_onehand_attack_blend_tree/on_attack/active\"]: result = true
		\"close_twohand\":
			if self[\"parameters/close_twohand_attack_blend_tree/on_attack/active\"]: result = true
		\"far_twohand\":
			if self[\"parameters/far_twohand_attack_blend_tree/on_attack/active\"]: result = true
	
	return result
	#var result: bool = false
	#var parameters: Array[String] = [
		##self[\"parameters/unequip_attack_blend_tree/is_block/current_state\"],
		#self[\"parameters/fists_attack_blend_tree/on_attack/active\"],
		#self[\"parameters/right_onehand_attack_blend_tree/on_attack/active\"],
		#self[\"parameters/left_onehand_attack_blend_tree/on_attack/active\"],
		#self[\"parameters/close_twohand_attack_blend_tree/on_attack/active\"],
		#self[\"parameters/far_twohand_attack_blend_tree/on_attack/active\"],
	#]
	#
	#if 'true' in parameters:
		#result = true
	#
	#return result

## Получает анимацию атаки
func get_attack() -> String:
	match self[\"parameters/weapon_type/current_state\"]:
		#\"unequip\":
			#return self[\"parameters/unequip_attack_blend_tree/on_attack/active\"]
		\"fists\":
			return self[\"parameters/fists_attack_blend_tree/attack_type/current_state\"]
		\"right_onehand\":
			return self[\"parameters/right_onehand_attack_blend_tree/attack_type/current_state\"]
		\"left_onehand\":
			return self[\"parameters/left_onehand_attack_blend_tree/attack_type/current_state\"]
		\"close_twohand\":
			return self[\"parameters/close_twohand_attack_blend_tree/attack_type/current_state\"]
		\"far_twohand\":
			return self[\"parameters/far_twohand_attack_blend_tree/attack_type/current_state\"]
	
	return ''

## Вызывает анимацию получения урона
@rpc(\"any_peer\", \"unreliable\", \"call_local\")
func damaged(from_target: Dictionary, self_target: Dictionary) -> void:
	var from: Node3D
	var to: Node3D
	for player: CharacterBody3D in get_tree().root.get_node('Main/Map').players.get_children():
		if player.name == self_target.get(\"name\"):
			to = player
			break
	if from_target.get(\"type\") == \"player\":
		for player: CharacterBody3D in get_tree().root.get_node('Main/Map').players.get_children():
			if player.name == from_target.get(\"name\"):
				from = player
				break
	elif from_target.get(\"type\") == \"entity\":
		for entity: CharacterBody3D in get_tree().root.get_node('Main/Map').entites.get_children():
			if entity.id == from_target.get(\"id\"):
				from = entity
				break
	var direction3: Vector3 = (from.global_transform.origin - to.global_transform.origin)
	var direction: Vector2 = Vector2(direction3.x, direction3.z)
	_damaged(direction)

## Запускает анимации получения урона
func _damaged(direction: Vector2) -> void:
	self[\"parameters/damaged/request\"] = AnimationNodeOneShot.ONE_SHOT_REQUEST_FIRE
	self[\"parameters/damage_direction/blend_position\"] = direction

func _on_animation_finished(anim_name: String) -> void:
	if anim_name == 'fall':
		move_state = 'idle'

## Переключает анимации в зависимости от экипированного оружия
func _on_inventory_entity_component_equipment_changed(equiped: Array[String]) -> void:
	if equiped[2] != \"\" and equiped[3] == \"\":
		var item: ItemData = ItemRegistry.get_item(equiped[2])
		if item.category == 'weapon':
			if item.has_component(WeaponItemComponent):
				var weapon_componet: WeaponItemComponent = item.get_component(WeaponItemComponent)
				if weapon_componet.weapon_type == 'one_hand':
					update_has_armed(true, 'right_onehand')
				if weapon_componet.weapon_type == 'close_twohand':
					update_has_armed(true, 'close_twohand')
				if weapon_componet.weapon_type == 'far_twohand':
					update_has_armed(true, 'far_twohand')
			elif item.category == 'shield':
				pass
	elif equiped[2] == \"\" and equiped[3] != \"\":
		var item: ItemData = ItemRegistry.get_item(equiped[3])
		if item.category == 'weapon':
			update_has_armed(true, 'left_onehand')
		elif item.category == 'shield':
			pass
	elif equiped[2] != \"\" and equiped[3] != \"\":
		pass
	else:
		update_has_armed(true, 'unequip')
"

[sub_resource type="GDScript" id="GDScript_3smsa"]
script/source = "extends Node3D

@onready var camera: Node3D = $Camera
@onready var model: Node3D = $Model
@export var mouse_sensitivity: float = 0.003
@export_range(-90, 0, 0.1, \"radians_as_degrees\") var min_vertical_angle: float = -PI/2
@export_range(0, 90, 0.1, \"radians_as_degrees\") var max_vertical_angle: float = PI/2

func _ready() -> void:
	$Model/blockbench_export/base/Skeleton3D/right_equip/TextureModel.parent = get_parent()

func _input(event: InputEvent) -> void:
	if get_multiplayer_authority() == multiplayer.get_unique_id():
		if event is InputEventMouseMotion and Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
			camera.rotate_y(-event.relative.x * mouse_sensitivity)
			#camera.rotation.y -= event.relative.x * mouse_sensitivity
			#camera.rotation.y = wrapf(rotation.y, 0, TAU)
			
			camera.rotation.x -= event.relative.y * mouse_sensitivity
			camera.rotation.x = clamp(camera.rotation.x, min_vertical_angle, max_vertical_angle)

@rpc(\"any_peer\")
func switch_camera(camera_id: int) -> void:
	match camera_id:
		1:
			if get_multiplayer_authority() == multiplayer.get_unique_id():
				$Camera/FirstCamera.current = true
				$Camera/ThirdCamera/OffsetCamera/Camera3D.current = false
			$Model.visible = false
		3:
			if get_multiplayer_authority() == multiplayer.get_unique_id():
				$Camera/FirstCamera.current = false
				$Camera/ThirdCamera/OffsetCamera/Camera3D.current = true
			$Model.visible = true

func _switch_camera(camera_id: int) -> void:
	match camera_id:
		1:
			$Camera/FirstCamera.current = true
			$Camera/ThirdCamera/OffsetCamera/Camera3D.current = false
			$Model.visible = false
		3:
			$Camera/FirstCamera.current = false
			$Camera/ThirdCamera/OffsetCamera/Camera3D.current = true
			$Model.visible = true

func sum_rotation(delta: float) -> void:
	var rot_speed: float = 10
	model.rotation.y = lerp_angle(model.rotation.y, camera.rotation.y, rot_speed * delta)
"

