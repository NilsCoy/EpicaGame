[sub_resource type="GDScript" id="GDScript_66hud"]
script/source = "extends HealthEntityComponent

@onready var player: CharacterBody3D = $\"../..\"


func _on_damaged(dmg: float, to_target: Dictionary, from_target: Dictionary) -> void:
	player.ui_health_update(value, max_value)
	player.animation.rpc('damaged', from_target, to_target)


func _on_died(reason: String) -> void:
	player.is_life = false
	player.component_container.get_component('RagDollEntityComponent').rpc('spawn_ragdoll')
	player.spawn()
"

[sub_resource type="GDScript" id="GDScript_2hnfo"]
script/source = "extends EnergyEntityComponent

@onready var player: CharacterBody3D = $\"../..\"

func _on_changed_value(old_value: float, new_value: float, reason: String) -> void:
	player.ui_energy_update(value, max_value)
"

