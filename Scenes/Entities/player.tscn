script/source = "extends CharacterBody3D

# Move
const JUMP_VELOCITY: float = 7.0
const WALK_SPEED: float = 2.0
const RUN_SPEED: float = 5.0
const AIR_SPEED: float = 8.0
var FLY_SPEED: float = 5.0
var current_speed: float = WALK_SPEED
var has_weapon: bool = true
var direction: Vector3

# Player settings
@export_range(0, 2, 1) var gamemode: int = 0 # 0=survival, 1=creative, 2=spectator
@export_range(0, 2, 1) var move_state: int = 1 # 0=crawl, 1=walk, 2=run
var fly: bool = false
var spawn_position: Vector3
var spawn_rotation: Vector3

# Utils
var curr_block: String = \"\":
	set(new_value):
		curr_block = new_value
		current_block_update.emit(new_value)
signal current_block_update(value: String)

var is_life: bool = true
@export var nickname: String = \"Player\"
@export var player_id: int = 1
## Постоянный идентификатор игрока (назначает сервер), по нему сохраняется инвентарь
var player_uuid: String = \"\"

@onready var inventory: Control = $UI/CreativeInventory
@onready var model: Node3D = $Character
@onready var camera: Node3D = $Character/Camera
@onready var animation: AnimationTree = $AnimationTree
@onready var components: Node = $ComponentContainer
@onready var user_interface: CanvasLayer = $UI
@onready var component_container: EntityComponentContainer = $ComponentContainer

## Сохранение всех переменных
func save_data() -> Dictionary:
	return {
		\"type\": \"player\",
		\"name\": nickname,
		\"nickname\": nickname,
		\"player_uuid\": player_uuid,
		\"position\": [position.x, position.y, position.z],
		\"rotation\": [model.model.rotation.x, model.model.rotation.y, model.model.rotation.z],
		\"spawn_position\": [spawn_position.x, spawn_position.y, spawn_position.z],
		\"spawn_rotation\": [spawn_rotation.x, spawn_rotation.y, spawn_rotation.z],
		\"health\": $ComponentContainer/HealthEntityComponent.value,
		\"max_health\": $ComponentContainer/HealthEntityComponent.max_value,
		\"fly\": fly,
		\"gamemode\": gamemode
	}

## Загрузка всех переменных
func load_data(data: Dictionary) -> void:
	self.name = data.get(\"name\", \"unknown\")
	self.nickname = data.get(\"nickname\", \"unknown\")
	self.player_uuid = data.get(\"player_uuid\", \"\")
	$UI/HUD/TopBar.update_nickname(self.nickname)
	
	self.position.x = data.get(\"position\", [0, 0, 0])[0]
	self.position.y = data.get(\"position\", [0, 0, 0])[1]
	self.position.z = data.get(\"position\", [0, 0, 0])[2]
	
	$Character/Model.rotation.x = data.get(\"rotation\", [0, 0, 0])[0]
	$Character/Model.rotation.y = data.get(\"rotation\", [0, 0, 0])[1]
	$Character/Model.rotation.z = data.get(\"rotation\", [0, 0, 0])[2]
	
	self.spawn_position.x = data.get(\"spawn_position\", [0, 0, 0])[0]
	self.spawn_position.y = data.get(\"spawn_position\", [0, 0, 0])[1]
	self.spawn_position.z = data.get(\"spawn_position\", [0, 0, 0])[2]
	
	self.spawn_rotation.x = data.get(\"spawn_rotation\", [0, 0, 0])[0]
	self.spawn_rotation.y = data.get(\"spawn_rotation\", [0, 0, 0])[1]
	self.spawn_rotation.z = data.get(\"spawn_rotation\", [0, 0, 0])[2]
	
	$ComponentContainer/HealthEntityComponent.value = data.get(\"health\", 100.0)
	$ComponentContainer/HealthEntityComponent.max_value = data.get(\"max_health\", 100.0)
	ui_health_update($ComponentContainer/HealthEntityComponent.value, $ComponentContainer/HealthEntityComponent.max_value)
	ui_energy_update($ComponentContainer/HealthEntityComponent.value, $ComponentContainer/HealthEntityComponent.max_value)
	
	fly = data.get(\"fly\", true)
	gamemode = data.get(\"gamemode\", 0)

## Сохранение данных
func save() -> void:
	FileManager.save_file('./world/players/'+nickname+'.json', self)
## Загрузка данных
func _load() -> void:
	var chunk_scene: Resource = preload(\"res://Scenes/Entities/player.tscn\")
	var files: Array = FileManager.get_files_in_directory('./world/players')
	if files != []:
		for file: String in files:
			if file.split('.')[0] == nickname:
				var result: Dictionary = FileManager.read_json(FileManager.get_file_path('./world/players/'+file, true))
				self.load_data(result)

## Сериализация данных
func serialize() -> PackedByteArray:
	var data: Dictionary = save_data()
	data[\"player_id\"] = player_id
	var bytes: PackedByteArray = var_to_bytes(data)
	return bytes.compress(FileAccess.COMPRESSION_GZIP)

#func _enter_tree() -> void:
	#set_multiplayer_authority(player_id)

func _ready() -> void:
	#if not(multiplayer.is_server()):
		#rpc_id(1, \"get_sunc_data\")
	#if multiplayer.get_unique_id() != player_id:
		#Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
		#$UI/CreativeInventory/ItemName.text = str(curr_block)
	#set_process(get_multiplayer_authority() == multiplayer.get_unique_id())
	if not(multiplayer.is_server()):
		var active: bool = get_multiplayer_authority() == multiplayer.get_unique_id()
		$UI.visible = active
		$Nickname.visible = not(active)
		$Nickname.text = self.name
		switch_gamemode(gamemode)
		animation.update_has_weapon(true, 'one_sword')
		if has_weapon:
			$Character/Model/Import/blockbench_export/base/Skeleton3D/right_equip/TextureModel.show()
		Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	pass

@rpc(\"authority\")
## Инициализация игрока меж пользователями
func init_sunc(data: Dictionary, id: int) -> void:
	load_data(data)
	#player_id = id
	#set_multiplayer_authority(player_id)
	var active: bool = get_multiplayer_authority() == multiplayer.get_unique_id()
	$UI.visible = active
	$Nickname.visible = not(active)
	$Nickname.text = self.name
	switch_gamemode(gamemode)
	animation.update_has_weapon(true, 'one_sword')
	if has_weapon:
		$Character/Model/Import/blockbench_export/base/Skeleton3D/right_equip/TextureModel.show()
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)

func _physics_process(delta: float) -> void:
	#print(multiplayer.get_unique_id())
	#print(player_id)
	if get_multiplayer_authority() != multiplayer.get_unique_id():
		return
	#if multiplayer.get_unique_id() != 1:
		#print(get_multiplayer_authority())
		#print(multiplayer.get_unique_id())
	
	_move(delta)
	
	#animation.animation_update()

func _input(event: InputEvent) -> void:
	if get_multiplayer_authority() != multiplayer.get_unique_id():
		return
	
	_ui(event)
	_attack(event)
	
	if gamemode == 2:
		if event is InputEventMouseMotion:
			_set_block_overlay()

## Атака игрока
func _attack(e: InputEvent) -> void:
	if has_weapon:
		if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
			if Input.is_action_just_pressed(\"left_click\") and animation.is_attack() == false:
				if animation.move_state == 'jump':
					animation.rpc('start_attack_animation', 'strong')
				elif animation.move_state == 'run':
					animation.rpc('start_attack_animation', 'lunge')
				else:
					animation.rpc('start_attack_animation', 'attack')
				$Character/Model/Import/blockbench_export/base/Skeleton3D/right_equip/TextureModel.attack()
			if Input.is_action_pressed(\"right_click\") and animation.is_attack() == false:
				if animation.is_block() == false:
					animation.rpc('start_attack_animation', 'block_pressed')
			else:
				if animation.is_block() == true:
					animation.rpc('start_attack_animation', 'block_relesed')

## Получаем поворот к блоку относительно камеры
func _get_rotation_from_forward(forward: Vector3) -> Vector3:
	if abs(forward.x) > abs(forward.z):
		return Vector3.RIGHT if forward.x > 0 else Vector3.LEFT
	else:
		return Vector3.BACK if forward.z > 0 else Vector3.FORWARD

## Получает позицию блока на который смотрит
func _get_block(raduis: int) -> Dictionary:
	var space_state: PhysicsDirectSpaceState3D = get_world_3d().direct_space_state
	
	var from: Vector3 = camera.global_transform.origin
	var to: Vector3 = from + camera.global_transform.basis.z * -1 * raduis
	
	var query: PhysicsRayQueryParameters3D = PhysicsRayQueryParameters3D.create(from, to)
	query.set_collision_mask(2)
	var result: Dictionary = space_state.intersect_ray(query)
	return result

## накладывает эффект оверлея на блоки в режиме строительства
func _set_block_overlay() -> void:
	var forward: Vector3 = -camera.global_transform.basis.z
	forward.y = 0
	forward = forward.normalized()
	
	var rot: Vector3 = _get_rotation_from_forward(forward)
	var result: Dictionary = _get_block(25)
	
	if result:
		$BlockOverlay.visible = true
		var block_coord: Vector3 = Vector3(
			floor(result.position.x) + 0.5,
			floor(result.position.y) + 0.5,
			floor(result.position.z) + 0.5
		)
		if result.normal.y>0:block_coord.y -= 1
		if result.normal.x>0:block_coord.x -= 1
		if result.normal.z>0:block_coord.z -= 1
		
		$BlockOverlay.overlay.global_position = Vector3(block_coord)
	else:
		$BlockOverlay.visible = false

## Установка блоков
@rpc(\"any_peer\")
func _place_block(raduis: int = 25, block: String = curr_block) -> void:
	var forward: Vector3 = -camera.global_transform.basis.z
	forward.y = 0
	forward = forward.normalized()
	
	var rot: Vector3 = _get_rotation_from_forward(forward)
	var result: Dictionary = _get_block(raduis)
	
	if result:
		var chunk: Node3D = result.collider.get_parent()
		if chunk.has_method(\"place_block\"):
			chunk.place_block(result.position, result.normal, block, rot)
			chunk.rpc(\"place_block\", result.position, result.normal, block, rot)

## Получает глобальные координаты блока
func _get_select_block_pos(raduis: int = 25) -> Variant:
	var result: Dictionary = _get_block(raduis)
	if result.is_empty():
		return null
	
	var inside: Vector3 = result.position - result.normal * 0.01
	return Vector3i(floori(inside.x), floori(inside.y), floori(inside.z))

## Копирование блока на который смотришь
func _copy_block(raduis: int = 25) -> void:
	var result: Dictionary = _get_block(raduis)
	if result.is_empty():
		return
	
	# 1. Получаем чанк (скрипт чанка)
	var collider: Node = result.collider
	# collider может быть StaticBody3D (меш-блоки) или родителем ModelBlock
	# В твоём коде: $StaticBody3D для мешей, а ModelBlock_* — тоже StaticBody3D,
	# и оба лежат прямо в чанке. Значит скрипт чанка — это collider.get_parent()
	# для меш-коллизии, ИЛИ сам collider, если это ModelBlock (у него скрипта нет).
	var chunk: Node = collider
	while chunk != null and not chunk.has_method(\"place_block\"):
		chunk = chunk.get_parent()
	
	if chunk == null:
		return
	
	# 2. Точка попадания -> локальные координаты внутри чанка
	#    Слегка сдвигаем внутрь по нормали, чтобы не попасть на границу
	var local_pos: Vector3 = chunk.to_local(result.position - result.normal * 0.01)
	
	var x: int = int(floor(local_pos.x))
	var y: int = int(floor(local_pos.y))
	var z: int = int(floor(local_pos.z))
	
	# 3. Проверка границ
	if x < 0 or y < 0 or z < 0 or \\
	   x >= chunk.CHUNK_SIZE or y >= chunk.CHUNK_SIZE or z >= chunk.CHUNK_SIZE:
		return
	
	var block_id: String = str(chunk.blocks[x][y][z][\"id\"])
	var block_rot: Vector3 = chunk.blocks[x][y][z][\"rotation\"]
	
	if block_id == \"air\":
		return
	
	curr_block = block_id

## Ломание блоков
func _break_block(raduis: int = 25) -> void:
	var result: Dictionary = _get_block(raduis)

	if result:
		var chunk: Variant = result.collider.get_parent()
		if chunk.has_method(\"break_block\"):
			chunk.break_block(result.position, result.normal)
			chunk.rpc(\"break_block\", result.position, result.normal)

## Основное движение игрока
func _move(delta: float) -> void:
	if is_on_floor() or fly == true:
		var anim_switch: bool = true
		if animation.move_state == 'jump' or animation.move_state == 'fall':
			if $AnimationTree/FallTimer.is_stopped():
				anim_switch = false
		else:
			anim_switch = true
		$AnimationTree/FallTimer.stop()
		#$UI/TestLabel.text = str(anim_switch)
		if anim_switch == true:
			if has_weapon == true: model.sum_rotation(delta)
			if velocity:
				if has_weapon == false: model.sum_rotation(delta)
				match move_state:
					1: animation.move_state = \"walk\"
					2: animation.move_state = \"run\"
			else: animation.move_state = \"idle\"
		else:
			animation.move_state = \"fall\"
	
	match gamemode:
		0: _survival_move(delta)
		1: _creative_move(delta)
		2: _spectator_move(delta)
	
	var input_dir: Vector2 = Input.get_vector(\"left\", \"right\", \"up\", \"down\")
	if Input.get_mouse_mode() != Input.MOUSE_MODE_CAPTURED:
		input_dir.x = 0
		input_dir.y = 0
	direction = (transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()
	var rot_speed: float = 5
	match input_dir:
		Vector2(0, -1): #FORWARD
			animation.move_direction = \"forward\"
			animation.move_rotate_direction = animation.move_rotate_direction.lerp(Vector2(0, 1), rot_speed*delta)
			if not has_weapon:
				$Character/Model/Import.rotation.y = lerpf($Character/Model/Import.rotation.y, deg_to_rad(0), rot_speed * delta)
		Vector2(0, 1): #BACK
			animation.move_direction = \"back\"
			animation.move_rotate_direction = animation.move_rotate_direction.lerp(Vector2(0, -1), rot_speed*delta)
			if not has_weapon:
				$Character/Model/Import.rotation.y = lerpf($Character/Model/Import.rotation.y, deg_to_rad(0), rot_speed * delta)
		Vector2(-1, 0): #LEFT
			if has_weapon:
				animation.move_rotate_direction = animation.move_rotate_direction.lerp(Vector2(-1, 0), rot_speed*delta)
			else:
				animation.move_rotate_direction = animation.move_rotate_direction.lerp(Vector2(0, -1), rot_speed*delta)
				$Character/Model/Import.rotation.y = lerpf($Character/Model/Import.rotation.y, deg_to_rad(90), rot_speed * delta)
		Vector2(1, 0): #RIGHT
			if has_weapon:
				animation.move_rotate_direction = animation.move_rotate_direction.lerp(Vector2(1, 0), rot_speed*delta)
			else:
				animation.move_rotate_direction = animation.move_rotate_direction.lerp(Vector2(0, -1), rot_speed*delta)
				$Character/Model/Import.rotation.y = lerpf($Character/Model/Import.rotation.y, -deg_to_rad(90), rot_speed * delta)
		Vector2.ZERO:
			animation.move_direction = \"forward\"
			animation.move_rotate_direction = animation.move_rotate_direction.lerp(Vector2.ZERO, rot_speed*delta)
		_:
			if (input_dir.x < 0 and input_dir.y < 0):
				animation.move_direction = \"forward\"
				if has_weapon:
					animation.move_rotate_direction = animation.move_rotate_direction.lerp(Vector2(-1, 1), rot_speed*delta)
				else:
					animation.move_rotate_direction = animation.move_rotate_direction.lerp(Vector2(0, 1), rot_speed*delta)
					$Character/Model/Import.rotation.y = lerpf($Character/Model/Import.rotation.y, deg_to_rad(45), rot_speed * delta)
			elif (input_dir.x > 0 and input_dir.y > 0):
				animation.move_direction = \"back\"
				if has_weapon:
					animation.move_rotate_direction = animation.move_rotate_direction.lerp(Vector2(1, -1), rot_speed*delta)
				else:
					animation.move_rotate_direction = animation.move_rotate_direction.lerp(Vector2(0, -1), rot_speed*delta)
					$Character/Model/Import.rotation.y = lerpf($Character/Model/Import.rotation.y, deg_to_rad(45), rot_speed * delta)
			elif (input_dir.x > 0 and input_dir.y < 0):
				animation.move_direction = \"forward\"
				if has_weapon:
					animation.move_rotate_direction = animation.move_rotate_direction.lerp(Vector2(1, 1), rot_speed*delta)
				else:
					animation.move_rotate_direction = animation.move_rotate_direction.lerp(Vector2(0, 1), rot_speed*delta)
					$Character/Model/Import.rotation.y = lerpf($Character/Model/Import.rotation.y, -deg_to_rad(45), rot_speed * delta)
			elif (input_dir.x < 0 and input_dir.y > 0):
				animation.move_direction = \"back\"
				if has_weapon:
					animation.move_rotate_direction = animation.move_rotate_direction.lerp(Vector2(-1, -1), rot_speed*delta)
				else:
					animation.move_rotate_direction = animation.move_rotate_direction.lerp(Vector2(0, -1), rot_speed*delta)
					$Character/Model/Import.rotation.y = lerpf($Character/Model/Import.rotation.y, -deg_to_rad(45), rot_speed * delta)
	
	direction = direction.rotated(Vector3.UP, camera.global_rotation.y)
	if animation.move_state != 'fall':
		if direction:
			if is_on_floor() or fly == true:
				velocity.x = direction.x * current_speed
				velocity.z = direction.z * current_speed
			else:
				velocity.x += direction.x * WALK_SPEED * delta
				velocity.z += direction.z * WALK_SPEED * delta
		else:
			if is_on_floor() or fly == true:
				velocity.x = move_toward(velocity.x, 0, current_speed)
				velocity.z = move_toward(velocity.z, 0, current_speed)
	else:
		velocity.x = move_toward(velocity.x, 0, current_speed)
		velocity.z = move_toward(velocity.z, 0, current_speed)

	move_and_slide()

## Работа с интерфейсами и кнопками
func _ui(e: InputEvent) -> void:

	if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
		if fly:
			_fly_speed(e)

		# если мы в спектаторе, то нажимая на цифры, мы выбираем блок
		if gamemode == 2: # spectator
			for i: int in range(10):
				if Input.is_action_just_pressed(str(i)):
					if inventory.hot_bar_data.slot_datas[i-1]:
						if inventory.hot_bar_data.slot_datas[i-1].item_data != null:
							if inventory.hot_bar_data.slot_datas[i-1].item_data.category == 'block':
								curr_block = inventory.hot_bar_data.slot_datas[i-1].item_data.item_name
					else: curr_block = \"\"
					break

			if e is InputEventMouseButton and e.pressed:
				if user_interface.world_edit_ui.visible:
					if e.button_index == MOUSE_BUTTON_MIDDLE:
						_copy_block(25)
				else:
					if e.button_index == MOUSE_BUTTON_LEFT:
						_break_block(25)
					if e.button_index == MOUSE_BUTTON_MIDDLE:
						_copy_block(25)
					elif e.button_index == MOUSE_BUTTON_RIGHT and curr_block != \"\":
						_place_block(25)
	
	if Input.is_action_just_pressed('F1'):
		user_interface.visible = not(user_interface.visible)
	if Input.is_action_just_pressed('F2'):
		var dir: DirAccess = FileManager.open_or_create_directory('user://','Screenshots')
		var t: Dictionary = Time.get_datetime_dict_from_system()
		var filename: String = \"screenshot_%04d-%02d-%02d_%02d-%02d-%02d.png\" % [t.year, t.month, t.day, t.hour, t.minute, t.second]
		await RenderingServer.frame_post_draw
		var image: Image = get_viewport().get_texture().get_image()
		image.save_png(dir.get_current_dir()+'/'+filename)
		print(\"Скриншот сохранён: \", dir.get_current_dir(false)+'/'+filename)
		ChatManager.rpc_id(player_id, '_message', \"Скриншот сохранён: \", dir.get_current_dir(false)+'/'+filename)
	if Input.is_action_just_pressed('F3'):
		$UI/HUD/PerformanceStats.visible = not($UI/HUD/PerformanceStats.visible)
	if Input.is_action_just_pressed('WorldEdit') and gamemode == 2:
		user_interface.world_edit_ui.visible = not(user_interface.world_edit_ui.visible)

## Изменение скорости полета
func _fly_speed(e: InputEvent) -> void:
	if e is InputEventMouseButton:
		if e.button_index == MOUSE_BUTTON_WHEEL_UP and FLY_SPEED < 50.0:
			FLY_SPEED += 0.5
		elif e.button_index == MOUSE_BUTTON_WHEEL_DOWN and FLY_SPEED > 5.0:
			FLY_SPEED -= 0.5

## Движение в спектаторе
func _spectator_move(delta: float) -> void:
	# There is no gravity
	if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
		if Input.is_action_pressed(\"space\"):
			velocity.y = FLY_SPEED
		elif Input.is_action_pressed(\"shift\"):
			velocity.y = -FLY_SPEED
		else:
			velocity.y = 0
		
		current_speed = FLY_SPEED

## Обычное движение
func _survival_move(delta: float) -> void:
	# Add the jump
	if is_on_floor():
		_try_step()
		if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
			if Input.is_action_just_pressed(\"space\") and animation.is_block() == false and animation.is_attack() == false:
				velocity.y = JUMP_VELOCITY
				animation.move_state = 'jump'
				$AnimationTree/FallTimer.start()
			
			if Input.is_action_pressed(\"shift\") and animation.is_block() == false:
				if animation.is_attack() == false or animation.get_attack() == 'lunge':
					current_speed = move_toward(current_speed, RUN_SPEED, 10*delta)
					move_state = 2
			else: 
				current_speed = move_toward(current_speed, WALK_SPEED, 10*delta)
				move_state = 1
	else:
		velocity += get_gravity() * delta
		if animation.move_state != 'jump':
			$AnimationTree/FallTimer.start()
			animation.move_state = 'jump'

## Поднятие на ступеньках
func _try_step() -> void:
	#var input_dir: Vector2 = client_synchronizer.direction
	#var direction: Vector3 = (transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()
	#direction = direction.rotated(Vector3.UP, camera.global_rotation.y)
	
	var step_height: float = 0.5
	var step_forward: float = 0.5
	
	# направление движения
	var move_dir: Vector3 = (direction*current_speed).normalized()
	move_dir.y = 0
	
	# поворачиваем рейкасты в сторону движения
	if move_dir.length() != 0:
		$LiftingRaycasts/LowerRay.target_position = move_dir * step_forward
		$LiftingRaycasts/UpperRay.target_position = move_dir * step_forward
		$LiftingRaycasts/UpperRay2.target_position = move_dir * step_forward
	
	# проверка ступеньки
	if $LiftingRaycasts/LowerRay.is_colliding() and not $LiftingRaycasts/UpperRay.is_colliding() and \\
	not $LiftingRaycasts/UpperRay2.is_colliding() and not $LiftingRaycasts/UpperRay3.is_colliding():
		
		var step_up: Vector3 = Vector3.UP * step_height
		var forward: Vector3 = move_dir * step_forward
		
		if not test_move(global_transform, step_up) \\
		and not test_move(global_transform.translated(step_up), forward):
			translate(step_up + (move_dir*0.2))

## Креативное движение
func _creative_move(delta: float) -> void:
	var fly_switch_timer: Timer = $AnimationTree/FlySwitchTimer
	if Input.is_action_just_pressed(\"space\"):
		if fly_switch_timer.is_stopped(): fly_switch_timer.start()
		else: 
			fly = not(fly)
			current_speed = RUN_SPEED
	if fly: _spectator_move(delta)
	else: _survival_move(delta)

#@rpc(\"any_peer\", \"reliable\")
#func switch_gamemode(to_gamemode: int) -> void:
	#gamemode = to_gamemode
	#if to_gamemode == 2:
		#model.rpc(\"switch_camera\", 1)
		#$CollisionShape3D.disabled = true
		#fly = true
	#else:
		#model.rpc(\"switch_camera\", 3)
		#$CollisionShape3D.disabled = false
#
#func _switch_camera() -> void:
	#model.rpc(\"switch_camera\", 1)

@rpc(\"any_peer\", \"reliable\")
## Меняет режим игрока
func switch_gamemode(to_gamemode: int) -> void:
	gamemode = to_gamemode
	if to_gamemode == 2:
		if not(multiplayer.is_server()):
			if get_multiplayer_authority() == multiplayer.get_unique_id():
				model._switch_camera(1)
				model.rpc(\"switch_camera\", 1)
				$UI/CreativeInventory.show()
		if not(get_multiplayer_authority() == multiplayer.get_unique_id()):
			$Nickname.hide()
		$CollisionShape3D.disabled = true
		fly = true
	else:
		if not(multiplayer.is_server()):
			if get_multiplayer_authority() == multiplayer.get_unique_id():
				model._switch_camera(3)
				model.rpc(\"switch_camera\", 3)
				$UI/CreativeInventory.hide()
		if not(get_multiplayer_authority() == multiplayer.get_unique_id()):
			$Nickname.show()
		$CollisionShape3D.disabled = false

#func _on_health_component_damaged(dmg: float, to_target: Dictionary, from_target: Dictionary) -> void:
	#var health: float = $ComponentContainer/HealthComponent.value
	#var max_health: float = $ComponentContainer/HealthComponent.max_value
	#if animation.is_block():
		#$ComponentContainer/HealthComponent.rpc('set_value', health+dmg, \"block\")
	#else:
		#var overlay_visible: float = (max_health-health)/max_health/2
		#$UI/HUD/HealthOverlay.modulate = Color(1, 1, 1, overlay_visible)
		#animation.rpc('damaged', from_target, to_target)
#
#func _on_health_component_died(reason: String) -> void:
	#is_life = false
	#$ComponentContainer/RagDollComponent.rpc('spawn_ragdoll')
	#spawn()

## Обновление здоровья игрока в интерфейсах
func ui_health_update(health: float, max_health: float) -> void:
	var overlay_visible: float = (max_health-health)/max_health/2
	$UI/HUD/HealthOverlay.modulate = Color(1, 1, 1, overlay_visible)
	$UI/HUD/TopBar.update_health(health, max_health)

## Обновление энергии игрока в интерфейсах
func ui_energy_update(energy: float, max_energy: float) -> void:
	$UI/HUD/TopBar.update_energy(energy, max_energy)

## Спавн игрока
func spawn() -> void:
	$UI/HUD/HealthOverlay.modulate = Color(1, 1, 1, 0)
	var health_component: HealthEntityComponent = component_container.get_component('HealthEntityComponent')
	health_component.value = health_component.max_value
	$UI/HUD/TopBar.update_health(health_component.value, health_component.max_value)
	position = spawn_position
	model.model.rotation = spawn_rotation
	is_life = true
"

