[sub_resource type="GDScript" id="GDScript_uhc0p"]
script/source = "extends CharacterBody3D

@onready var animation: AnimationTree = $AnimationTree
@onready var components: Node = $ComponentContainer
@export var is_life: bool = true
@export var id: String

func save_data() -> Dictionary:
	return {
		\"type\": scene_file_path.get_file().get_basename(),
		\"id\": id,
		\"position\": [position.x, position.y, position.z],
		\"rotation\": [rotation.x, rotation.y, rotation.z],
		\"health\": $ComponentContainer/HealthEntityComponent.value,
		\"max_health\": $ComponentContainer/HealthEntityComponent.max_value,
	}

func load_data(data: Dictionary) -> void:
	self.id = data.get(\"id\", Global.generate_uuid_v4())
	
	self.position.x = data.get(\"position\", Vector3.ZERO)[0]
	self.position.y = data.get(\"position\", Vector3.ZERO)[1]
	self.position.z = data.get(\"position\", Vector3.ZERO)[2]
	
	self.rotation.x = data.get(\"rotation\", Vector3.ZERO)[0]
	self.rotation.y = data.get(\"rotation\", Vector3.ZERO)[1]
	self.rotation.z = data.get(\"rotation\", Vector3.ZERO)[2]
	
	$ComponentContainer/HealthEntityComponent.value = data.get(\"health\", 100.0)
	$ComponentContainer/HealthEntityComponent.max_value = data.get(\"max_health\", 100.0)

func _ready() -> void:
	if get_multiplayer_authority() == multiplayer.get_unique_id():
		id = Global.generate_uuid_v4()
		name = id
	$Sprite3D/SubViewport/Damage.text = ''
	_health_update()

func _physics_process(delta: float) -> void:
	if not is_on_floor():
		velocity += get_gravity() * delta
	
	move_and_slide()


func _on_health_component_damaged(dmg: float, to_target: Dictionary, from_target: Dictionary) -> void:
	$Sprite3D/SubViewport/Damage.text = str(dmg)
	_health_update()
	$Sprite3D/TextTimer.start()
	
	if from_target.get(\"type\") == \"player\":
		for player: CharacterBody3D in get_tree().root.get_node('Main/Map').players.get_children():
			if player.name == from_target.get(\"name\"):
				animation[\"parameters/damaged/request\"] = AnimationNodeOneShot.ONE_SHOT_REQUEST_FIRE
				var direction3: Vector3 = (player.global_transform.origin - global_transform.origin)
				var direction: Vector2 = Vector2(direction3.x, direction3.z)
				animation[\"parameters/damage_direction/blend_position\"] = direction
	elif from_target.get(\"type\") == \"entity\":
		for entity: CharacterBody3D in get_tree().root.get_node('Main/Map').entites.get_children():
			if entity.id == from_target.get(\"id\"):
				animation[\"parameters/damaged/request\"] = AnimationNodeOneShot.ONE_SHOT_REQUEST_FIRE
				var direction3: Vector3 = (entity.global_transform.origin - global_transform.origin)
				var direction: Vector2 = Vector2(direction3.x, direction3.z)
				animation[\"parameters/damage_direction/blend_position\"] = direction

func _on_health_component_died(reason: String) -> void:
	is_life = false
	_health_update()

func _health_update() -> void:
	if is_life:
		$Sprite3D/SubViewport/Health.text = str($ComponentContainer/HealthEntityComponent.value) + ' / ' + str($ComponentContainer/HealthEntityComponent.max_value)
	else:
		$Sprite3D/SubViewport/Health.text = 'Died' + ' / ' + str($ComponentContainer/HealthEntityComponent.max_value)

func _on_text_timer_timeout() -> void:
	$Sprite3D/SubViewport/Damage.text = ''
"

