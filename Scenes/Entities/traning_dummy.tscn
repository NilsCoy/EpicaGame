[sub_resource type="GDScript" id="GDScript_gaqyi"]
script/source = "@tool
extends SubViewport

func _process(delta: float) -> void:
	if $Damage.size.x >= $Health.size.x:
		size.x = $Damage.size.x
	else:
		size.x = $Health.size.x
	size.y = $Health.size.y + $Damage.size.y
	
"

