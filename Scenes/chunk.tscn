[gd_scene format=3 uid="uid://bfos268tpe1gs"]

[sub_resource type="GDScript" id="GDScript_1i61x"]
script/source = "extends Node3D

const CHUNK_SIZE = 16
@export var starter_block = false

var blocks = []
@onready var mesh_instance = $MeshInstance3D
@onready var collision_shape = $StaticBody3D/CollisionShape3D

func _ready():
	generate_blocks()
	if starter_block: blocks[0][0][0] = true
	rebuild()

func generate_blocks():
	blocks.resize(CHUNK_SIZE)
	for x in CHUNK_SIZE:
		blocks[x] = []
		blocks[x].resize(CHUNK_SIZE)
		for y in CHUNK_SIZE:
			blocks[x][y] = []
			blocks[x][y].resize(CHUNK_SIZE)
			for z in CHUNK_SIZE:
				blocks[x][y][z] = false

func is_block(x, y, z):
	if x < 0 or y < 0 or z < 0:
		return false
	if x >= CHUNK_SIZE or y >= CHUNK_SIZE or z >= CHUNK_SIZE:
		return false
	return blocks[x][y][z]

func rebuild():
	var st = SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)

	for x in CHUNK_SIZE:
		for y in CHUNK_SIZE:
			for z in CHUNK_SIZE:
				if blocks[x][y][z]:
					add_block_faces(st, x, y, z)
	
	#greedy_mesh(st)

	var mesh = st.commit()
	mesh_instance.mesh = mesh

	# Коллизия
	collision_shape.shape = mesh.create_trimesh_shape()

func add_block_faces(st, x, y, z):
	var pos = Vector3(x, y, z)

	# UP
	if not is_block(x, y + 1, z):
		add_face(st, pos, Vector3.UP)

	# DOWN
	if not is_block(x, y - 1, z):
		add_face(st, pos, Vector3.DOWN)

	# RIGHT
	if not is_block(x + 1, y, z):
		add_face(st, pos, Vector3.RIGHT)

	# LEFT
	if not is_block(x - 1, y, z):
		add_face(st, pos, Vector3.LEFT)

	# FORWARD
	if not is_block(x, y, z - 1):
		add_face(st, pos, Vector3.FORWARD)

	# BACK
	if not is_block(x, y, z + 1):
		add_face(st, pos, Vector3.BACK)

func add_face(st: SurfaceTool, pos: Vector3, normal: Vector3):

	var v = []

	match normal:
		Vector3.UP:
			v = [
				pos + Vector3(0,1,0),
				pos + Vector3(1,1,0),
				pos + Vector3(1,1,1),
				pos + Vector3(0,1,1)
			]

		Vector3.DOWN:
			v = [
				pos + Vector3(0,0,0),
				pos + Vector3(0,0,1),
				pos + Vector3(1,0,1),
				pos + Vector3(1,0,0)
			]

		Vector3.RIGHT:
			v = [
				pos + Vector3(1,0,0),
				pos + Vector3(1,0,1),
				pos + Vector3(1,1,1),
				pos + Vector3(1,1,0)
			]

		Vector3.LEFT:
			v = [
				pos + Vector3(0,0,0),
				pos + Vector3(0,1,0),
				pos + Vector3(0,1,1),
				pos + Vector3(0,0,1)
			]

		# Грань вперед (Z-) → FORWARD
		Vector3(0,0,-1):
			v = [
				pos + Vector3(0,0,0),
				pos + Vector3(1,0,0),
				pos + Vector3(1,1,0),
				pos + Vector3(0,1,0)
			]

		# Грань назад (Z+) → BACK
		Vector3(0,0,1):
			v = [
				pos + Vector3(0,0,1),
				pos + Vector3(0,1,1),
				pos + Vector3(1,1,1),
				pos + Vector3(1,0,1)
			]

	# Треугольник 1
	st.set_normal(normal)
	st.add_vertex(v[0])

	st.set_normal(normal)
	st.add_vertex(v[1])

	st.set_normal(normal)
	st.add_vertex(v[2])

	# Треугольник 2
	st.set_normal(normal)
	st.add_vertex(v[0])

	st.set_normal(normal)
	st.add_vertex(v[2])

	st.set_normal(normal)
	st.add_vertex(v[3])

func place_block(hit_position: Vector3, normal: Vector3):
	var local_pos = to_local(hit_position + normal * 0.5)
	
	var x = floor(local_pos.x)
	var y = floor(local_pos.y)
	var z = floor(local_pos.z)

	if x >= 0 and y >= 0 and z >= 0 and \\
		x < CHUNK_SIZE and y < CHUNK_SIZE and z < CHUNK_SIZE:
		
		blocks[x][y][z] = true
		rebuild()
	else:
		var neighbor_chunk_pos = position + normal * CHUNK_SIZE
		var chunk_name = 'chunk_' + str(int(neighbor_chunk_pos.x / CHUNK_SIZE)) + \\
						 '_' + str(int(neighbor_chunk_pos.y / CHUNK_SIZE)) + \\
						 '_' + str(int(neighbor_chunk_pos.z / CHUNK_SIZE))
		var chunk = get_parent().get_node(chunk_name)
		if chunk == null:
			chunk = load(\"res://Scenes/chunk.tscn\").instantiate()
			chunk.position = neighbor_chunk_pos
			chunk.name = chunk_name
			get_parent().add_child(chunk)
			
		var neighbor_local_pos = chunk.to_local(hit_position + normal * 0.5)
		var nx = floor(neighbor_local_pos.x)
		var ny = floor(neighbor_local_pos.y)
		var nz = floor(neighbor_local_pos.z)
		
		chunk.blocks[nx][ny][nz] = true
		chunk.rebuild()

func break_block(hit_position: Vector3, normal: Vector3):
	var local_pos = to_local(hit_position - normal * 0.01)
	
	var x = floor(local_pos.x)
	var y = floor(local_pos.y)
	var z = floor(local_pos.z)

	if x >= 0 and y >= 0 and z >= 0 and \\
		x < CHUNK_SIZE and y < CHUNK_SIZE and z < CHUNK_SIZE:
		
		blocks[x][y][z] = false
		rebuild()















func greedy_mesh(st: SurfaceTool) -> void:
	var dims = [CHUNK_SIZE, CHUNK_SIZE, CHUNK_SIZE]
	var mask = []

	for d in 3:  # d = 0,1,2 -> X,Y,Z
		var u = (d + 1) % 3
		var v = (d + 2) % 3

		var q = Vector3i()
		q[d] = 1

		for id in range(-1, dims[d]):
			mask.clear()
			
			# строим маску для слоя
			for j_v in range(dims[v]):
				for i_u in range(dims[u]):
					var x = Vector3i()
					x[d] = id
					x[u] = i_u
					x[v] = j_v

					var a = false
					var b = false
					if id >= 0:
						a = get_block_vec(x)
					if id < dims[d] - 1:
						b = get_block_vec(x + q)

					if a != b:
						mask.append(a)
					else:
						mask.append(null)

			# greedy по 2D маске
			var n = 0
			for j_v in range(dims[v]):
				var i_u = 0
				while i_u < dims[u]:
					if mask[n] != null:
						# ширина
						var w = 1
						while i_u + w < dims[u] and mask[n + w] == mask[n]:
							w += 1

						# высота
						var h = 1
						var done = false
						while j_v + h < dims[v] and not done:
							for k_w in range(w):
								if mask[n + k_w + h * dims[u]] != mask[n]:
									done = true
									break
							if not done:
								h += 1

						# создаем quad
						var x0 = Vector3i()
						x0[d] = id + 1
						x0[u] = i_u
						x0[v] = j_v

						var du = Vector3i()
						du[u] = w
						var dv = Vector3i()
						dv[v] = h

						add_quad(st, x0, du, dv, d, mask[n])

						# очищаем маску
						for l_h in range(h):
							for k_w in range(w):
								mask[n + k_w + l_h * dims[u]] = null

						i_u += w
						n += w
					else:
						i_u += 1
						n += 1

# универсальное добавление квадов для любого направления
func add_quad(st: SurfaceTool, pos: Vector3i, du: Vector3i, dv: Vector3i, d: int, filled: bool):
	var p = Vector3(pos)
	var du3 = Vector3(du.x, du.y, du.z)
	var dv3 = Vector3(dv.x, dv.y, dv.z)

	var v1 = p
	var v2 = p + du3
	var v3 = p + du3 + dv3
	var v4 = p + dv3

	var normal = Vector3()

	# Явно задаем нормаль и порядок вершин в зависимости от направления
	match d:
		0: # X-ось
			normal = Vector3(1,0,0) if filled else Vector3(-1,0,0)
			if filled:
				st.add_vertex(v1); st.add_vertex(v3); st.add_vertex(v2)
				st.add_vertex(v1); st.add_vertex(v4); st.add_vertex(v3)
			else:
				st.add_vertex(v1); st.add_vertex(v2); st.add_vertex(v3)
				st.add_vertex(v1); st.add_vertex(v3); st.add_vertex(v4)
		1: # Y-ось
			normal = Vector3(0,1,0) if filled else Vector3(0,-1,0)
			if filled:
				st.add_vertex(v1); st.add_vertex(v3); st.add_vertex(v2)
				st.add_vertex(v1); st.add_vertex(v4); st.add_vertex(v3)
			else:
				st.add_vertex(v1); st.add_vertex(v2); st.add_vertex(v3)
				st.add_vertex(v1); st.add_vertex(v3); st.add_vertex(v4)
		2: # Z-ось
			normal = Vector3(0,0,1) if filled else Vector3(0,0,-1)
			if filled:
				st.add_vertex(v1); st.add_vertex(v3); st.add_vertex(v2)
				st.add_vertex(v1); st.add_vertex(v4); st.add_vertex(v3)
			else:
				st.add_vertex(v1); st.add_vertex(v2); st.add_vertex(v3)
				st.add_vertex(v1); st.add_vertex(v3); st.add_vertex(v4)

	# для всех вершин нормаль одна
	st.set_normal(normal)

func get_block_vec(v: Vector3i) -> bool:
	if v.x < 0 or v.y < 0 or v.z < 0:
		return false
	if v.x >= CHUNK_SIZE or v.y >= CHUNK_SIZE or v.z >= CHUNK_SIZE:
		return false
	return blocks[v.x][v.y][v.z]
"

