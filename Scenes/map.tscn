[sub_resource type="GDScript" id="GDScript_58wgy"]
script/source = "extends Node3D

var chunk_scene := load(\"res://Scenes/chunk.tscn\")
var chunk: Node3D

func _ready():
	var files = $SaveSystem.get_files_in_directory('world')
	if files != []:
		for file in files:
			chunk = $SaveSystem.load_file('world/'+file, chunk_scene)
			add_child(chunk)
	else:
		chunk = chunk_scene.instantiate()
		chunk.starter_block = true
		add_child(chunk)

func _input(event):
	if Input.is_action_just_pressed('fast_save'):
		for chunk in get_children():
			if 'chunk' in chunk.name:
				$SaveSystem.save_file('world/'+chunk.name+'.json', chunk)
"

