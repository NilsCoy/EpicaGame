[sub_resource type="GDScript" id="GDScript_8erm5"]
script/source = "extends AnimationTree

@export_enum('idle', 'walk', 'run') var move_state = 'idle'
@export_enum('forward', 'back') var move_direction = 'forward'
@export var move_rotate_direction = Vector2.ZERO
@export var is_weapon = false

func update_move_state():
	self[\"parameters/move_blend_tree/move_state/transition_request\"] = move_state
	self[\"parameters/AnimationNodeBlendTree/move_state/transition_request\"] = move_state
	self[\"parameters/weapon_move_state/transition_request\"] = move_state

func update_move_direction():
	self[\"parameters/move_blend_tree/walk_direction/transition_request\"] = move_direction
	self[\"parameters/move_blend_tree/run_direction/transition_request\"] = move_direction
	self[\"parameters/AnimationNodeBlendTree/walk_direction/transition_request\"] = move_direction
	self[\"parameters/AnimationNodeBlendTree/run_direction/transition_request\"] = move_direction

func update_move_rotate_direction():
	self[\"parameters/move_blend_tree/walk_rotate_direction/blend_position\"] = move_rotate_direction
	self[\"parameters/move_blend_tree/run_rotate_direction/blend_position\"] = move_rotate_direction
	self[\"parameters/AnimationNodeBlendTree/walk_rotate_direction/blend_position\"] = move_rotate_direction
	self[\"parameters/AnimationNodeBlendTree/run_rotate_direction/blend_position\"] = move_rotate_direction
"

[sub_resource type="GDScript" id="GDScript_3smsa"]
script/source = "extends Node3D

@onready var camera = $Camera
@onready var model = $Model
@export var mouse_sensitivity: float = 0.003
@export_range(-90, 0, 0.1, \"radians_as_degrees\") var min_vertical_angle: float = -PI/2
@export_range(0, 90, 0.1, \"radians_as_degrees\") var max_vertical_angle: float = PI/4

func _input(event) -> void:
	if event is InputEventMouseMotion and Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
		camera.rotate_y(-event.relative.x * mouse_sensitivity)
		#camera.rotation.y -= event.relative.x * mouse_sensitivity
		#camera.rotation.y = wrapf(rotation.y, 0, TAU)
		
		camera.rotation.x -= event.relative.y * mouse_sensitivity
		camera.rotation.x = clamp(camera.rotation.x, min_vertical_angle, max_vertical_angle)

func switch_camera(camera_id: int) -> void:
	match camera_id:
		1:
			$Camera/FirstCamera.current = true
			$Camera/ThirdCamera/Camera3D.current = false
			$Model.visible = false
		3:
			$Camera/FirstCamera.current = false
			$Camera/ThirdCamera/Camera3D.current = true
			$Model.visible = true

func sum_rotation(delta) -> void:
	var rot_speed = 10
	model.rotation.y = lerp_angle(model.rotation.y, camera.rotation.y, rot_speed * delta)
"

