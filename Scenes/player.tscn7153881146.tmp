[sub_resource type="GDScript" id="GDScript_8erm5"]
script/source = "extends AnimationTree

@export_enum('idle', 'walk', 'run', 'jump', 'fall', 'block') var move_state: String = 'idle'
@export_enum('forward', 'back') var move_direction: String = 'forward'
@export var move_rotate_direction: Vector2 = Vector2.ZERO
@export var is_weapon: bool = false

func _ready() -> void:
	update_move_state(move_state)
	update_move_direction(move_direction)
	update_move_rotate_direction(move_rotate_direction)

func _physics_process(delta: float) -> void:
	if get_parent().is_on_floor():
		if move_state == 'jump':
			update_move_state('fall')

func update_move_state(state: String) -> void:
	move_state = state
	self[\"parameters/move_blend_tree/move_state/transition_request\"] = move_state
	self[\"parameters/AnimationNodeBlendTree/move_state/transition_request\"] = move_state
	self[\"parameters/weapon_move_state/transition_request\"] = move_state

func update_move_direction(direction: String) -> void:
	move_direction = direction
	self[\"parameters/move_blend_tree/walk_direction/transition_request\"] = move_direction
	self[\"parameters/move_blend_tree/run_direction/transition_request\"] = move_direction
	self[\"parameters/AnimationNodeBlendTree/walk_direction/transition_request\"] = move_direction
	self[\"parameters/AnimationNodeBlendTree/run_direction/transition_request\"] = move_direction

func update_move_rotate_direction(rotate_direction: Vector2) -> void:
	move_rotate_direction = rotate_direction
	self[\"parameters/move_blend_tree/walk_rotate_direction/blend_position\"] = move_rotate_direction
	self[\"parameters/move_blend_tree/run_rotate_direction/blend_position\"] = move_rotate_direction
	self[\"parameters/move_blend_tree/jump_rotate_direction/blend_position\"] = move_rotate_direction
	self[\"parameters/AnimationNodeBlendTree/walk_rotate_direction/blend_position\"] = move_rotate_direction
	self[\"parameters/AnimationNodeBlendTree/run_rotate_direction/blend_position\"] = move_rotate_direction
	self[\"parameters/AnimationNodeBlendTree/jump_rotate_direction/blend_position\"] = move_rotate_direction

func start_attack_animation(state: String) -> void:
	match state:
		'attack':
			if self[\"parameters/attack_type/current_state\"] == 'attack_1' and not $AttackTimer.is_stopped():
				self[\"parameters/attack_type/transition_request\"] = 'attack_2'
				self[\"parameters/on_attack/request\"] = AnimationNodeOneShot.ONE_SHOT_REQUEST_FIRE
				$AttackTimer.start()
			elif self[\"parameters/attack_type/current_state\"] == 'attack_2' and not $AttackTimer.is_stopped():
				self[\"parameters/attack_type/transition_request\"] = 'attack_1'
				self[\"parameters/on_attack/request\"] = AnimationNodeOneShot.ONE_SHOT_REQUEST_FIRE
				$AttackTimer.start()
			else:
				self[\"parameters/attack_type/transition_request\"] = 'attack_1'
				self[\"parameters/on_attack/request\"] = AnimationNodeOneShot.ONE_SHOT_REQUEST_FIRE
				$AttackTimer.start()
		'strong':
			self[\"parameters/attack_type/transition_request\"] = 'strong'
			self[\"parameters/on_attack/request\"] = AnimationNodeOneShot.ONE_SHOT_REQUEST_FIRE
		'lunge':
			self[\"parameters/attack_type/transition_request\"] = 'lunge'
			self[\"parameters/on_attack/request\"] = AnimationNodeOneShot.ONE_SHOT_REQUEST_FIRE
		'block':
			self[\"parameters/weapon_move_state/transition_request\"] = 'block'
			move_state = 'block'

func _on_animation_finished(anim_name: String) -> void:
	if anim_name == 'fall':
		move_state = 'idle'
"

[sub_resource type="GDScript" id="GDScript_3smsa"]
script/source = "extends Node3D

@onready var camera: Node3D = $Camera
@onready var model: Node3D = $Model
@export var mouse_sensitivity: float = 0.003
@export_range(-90, 0, 0.1, \"radians_as_degrees\") var min_vertical_angle: float = -PI/2
@export_range(0, 90, 0.1, \"radians_as_degrees\") var max_vertical_angle: float = PI/2

func _input(event: InputEvent) -> void:
	if event is InputEventMouseMotion and Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
		camera.rotate_y(-event.relative.x * mouse_sensitivity)
		#camera.rotation.y -= event.relative.x * mouse_sensitivity
		#camera.rotation.y = wrapf(rotation.y, 0, TAU)
		
		camera.rotation.x -= event.relative.y * mouse_sensitivity
		camera.rotation.x = clamp(camera.rotation.x, min_vertical_angle, max_vertical_angle)

func switch_camera(camera_id: int) -> void:
	match camera_id:
		1:
			$Camera/FirstCamera.current = true
			$Camera/ThirdCamera/OffsetCamera/Camera3D.current = false
			$Model.visible = false
		3:
			$Camera/FirstCamera.current = false
			$Camera/ThirdCamera/OffsetCamera/Camera3D.current = true
			$Model.visible = true

func sum_rotation(delta: float) -> void:
	var rot_speed: float = 10
	model.rotation.y = lerp_angle(model.rotation.y, camera.rotation.y, rot_speed * delta)
"

