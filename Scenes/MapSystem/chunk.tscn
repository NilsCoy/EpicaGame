script/source = "extends Node3D

var CHUNK_SIZE: int = WorldEdit.CHUNK_SIZE
@export var starter_block: bool = false
@export var loaded_chunk: bool = false

@export var blocks: Array = []

@onready var mesh_instance: MeshInstance3D = $MeshInstance3D
@onready var collision_shape: CollisionShape3D = $StaticBody3D/CollisionShape3D
@onready var atlas_generator: Node = $GenerateTextureAtlas

var rebuild_thread: Thread = Thread.new()

func save_data() -> Dictionary:
	var blocks_ids: Array = []
	var blocks_rotations: Array = []
	blocks_ids.resize(CHUNK_SIZE)
	blocks_rotations.resize(CHUNK_SIZE)
	for x: int in CHUNK_SIZE:
		blocks_ids[x] = []
		blocks_ids[x].resize(CHUNK_SIZE)
		blocks_rotations[x] = []
		blocks_rotations[x].resize(CHUNK_SIZE)
		for y: int in CHUNK_SIZE:
			blocks_ids[x][y] = []
			blocks_ids[x][y].resize(CHUNK_SIZE)
			blocks_rotations[x][y] = []
			blocks_rotations[x][y].resize(CHUNK_SIZE)
			for z: int in CHUNK_SIZE:
				blocks_ids[x][y][z] = str(blocks[x][y][z][\"id\"])
				blocks_rotations[x][y][z] = [blocks[x][y][z][\"rotation\"].x, blocks[x][y][z][\"rotation\"].y, blocks[x][y][z][\"rotation\"].z]
	
	return {
		\"name\": name,
		\"position\": [position.x, position.y, position.z],
		\"blocks_ids\": blocks_ids,
		\"blocks_rotations\": blocks_rotations,
	}

func load_data(data: Dictionary) -> void:
	self.name = data.get(\"name\", 'chunk_unknown')
	
	self.position.x = data.get(\"position\", Vector3.ZERO)[0]
	self.position.y = data.get(\"position\", Vector3.ZERO)[1]
	self.position.z = data.get(\"position\", Vector3.ZERO)[2]
	
	generate_blocks(
		data.get(\"blocks_ids\", [[[]]]),
		data.get(\"blocks_rotations\", [[[]]])
	)
	
	loaded_chunk = true

func serialize() -> PackedByteArray:
	var data: Dictionary = {
		\"name\" = name,
		\"blocks\" = blocks,
		\"position\" = position
	}
	var bytes: PackedByteArray = var_to_bytes(data)
	return bytes.compress(FileAccess.COMPRESSION_GZIP)

func _ready() -> void:
	if blocks == []:
		generate_blocks()
		#rebuild()
	
	if starter_block:
		blocks[0][0][0] = {
			\"id\": \"stone\",
			\"rotation\": Vector3.UP
		} # первый блок
		if not(multiplayer.is_server()):
			rebuild()
	if loaded_chunk:
		if not(multiplayer.is_server()):
			rebuild()

# Генерация массива блоков
func generate_blocks(blocks_ids: Array = [[[]]], blocks_rotations: Array = [[[]]]) -> void:
	blocks.resize(CHUNK_SIZE)
	for x: int in CHUNK_SIZE:
		blocks[x] = []
		blocks[x].resize(CHUNK_SIZE)
		for y: int in CHUNK_SIZE:
			blocks[x][y] = []
			blocks[x][y].resize(CHUNK_SIZE)
			for z: int in CHUNK_SIZE:
				if blocks_ids == [[[]]]:
					blocks[x][y][z] = {
						\"id\": \"air\", # 0 = воздух
						\"rotation\": Vector3.ZERO
					}
				else:
					blocks[x][y][z] = {
						\"id\": blocks_ids[x][y][z],
						\"rotation\": Vector3(blocks_rotations[x][y][z][0], blocks_rotations[x][y][z][1], blocks_rotations[x][y][z][2])
					}


func is_block(x: int, y: int, z: int) -> bool:
	if x < 0 or y < 0 or z < 0:
		return false
	if x >= CHUNK_SIZE or y >= CHUNK_SIZE or z >= CHUNK_SIZE:
		return false
	return blocks[x][y][z]['id'] != \"air\" and atlas_generator.blocks[str(blocks[x][y][z]['id'])][\"type\"] != \"model\"


# Перестроение меша
func rebuild() -> void:
	#if OS.has_feature(\"dedicated_server\"):
		#return
	
	for child: Node in get_children():
		if 'ModelBlock' in child.name:
			child.free()

	#if rebuild_thread.is_started():
		#rebuild_thread.wait_to_finish()
	#rebuild_thread.start(_rebuild)
	_rebuild()

func _rebuild() -> void:
	var has_ModelBlock: bool = false
	
	var st: SurfaceTool = SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)

	for x: int in CHUNK_SIZE:
		for y: int in CHUNK_SIZE:
			for z: int in CHUNK_SIZE:
				var block_data: Dictionary = blocks[x][y][z]
				var block_id: String = str(block_data[\"id\"])
				if block_id != \"air\":
					var block_rotation: Vector3 = block_data[\"rotation\"]
					if atlas_generator.blocks[block_id][\"type\"] == \"model\":
						call_deferred(\"add_model_block\", x, y, z, block_id, block_rotation)
						has_ModelBlock = true
					else:
						add_block_faces(st, x, y, z, block_id, block_rotation)

	var mesh: ArrayMesh = st.commit()

	if mesh.get_surface_count() == 0 and has_ModelBlock == false:
		queue_free()
		return
	
	var material: StandardMaterial3D = StandardMaterial3D.new()
	material.albedo_texture = atlas_generator.atlas_texture
	material.uv1_scale = Vector3(1, 1, 1)
	material.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	material.roughness = 1.0

	if mesh.get_surface_count() != 0:
		mesh.surface_set_material(0, material)

	call_deferred(\"update_mesh\", mesh)

func update_mesh(mesh: ArrayMesh) -> void:
	mesh_instance.mesh = mesh
	collision_shape.shape = mesh.create_trimesh_shape()

# Добавление блок-модель
func add_model_block(x: int, y: int, z: int, block_id: String, block_rotation: Vector3) -> void:
	var scene: Resource = load(atlas_generator.blocks[block_id][\"asset\"])
	var instance: Variant = scene.instantiate()

	Global.create_collision(instance,[1],[1])
	var static_instance: StaticBody3D = StaticBody3D.new()
	#instance = G.replace_to_static(instance)
	static_instance.add_child(instance)
	
	static_instance.set_collision_mask_value(1, false)
	static_instance.set_collision_mask_value(2, true)
	static_instance.set_collision_layer_value(1, false)
	static_instance.set_collision_layer_value(2, true)
	
	var collision: CollisionShape3D = CollisionShape3D.new()
	var box: BoxShape3D = BoxShape3D.new()
	box.size = Vector3(1, 1, 1)
	collision.shape = box
	collision.position = Vector3(0.5, 0.5, 0.5)
	static_instance.add_child(collision)

	static_instance.position = Vector3(x, y, z)

	# Поворот по направлению
	#print(block_rotation)
	if block_rotation == Vector3.RIGHT:
		instance.rotation_degrees.y = -90
		instance.position.x += 1
	elif block_rotation == Vector3.LEFT:
		instance.rotation_degrees.y = 90
		instance.position.z += 1
	elif block_rotation == Vector3.BACK:
		instance.rotation_degrees.y = 180
		instance.position.x += 1
		instance.position.z += 1
	
	static_instance.name = \"ModelBlock_\" + str(x) + \"_\" + str(y) + \"_\" + str(z)
	add_child(static_instance)

# Добавление граней блока
func add_block_faces(st: SurfaceTool, x: int, y: int, z: int, block_id: String, block_rotation: Vector3) -> void:
	var pos: Vector3 = Vector3(x, y, z)

	if not is_block(x, y + 1, z):
		add_face(st, pos, Vector3.UP, block_id, block_rotation)

	if not is_block(x, y - 1, z):
		add_face(st, pos, Vector3.DOWN, block_id, block_rotation)

	if not is_block(x + 1, y, z):
		add_face(st, pos, Vector3.RIGHT, block_id, block_rotation)

	if not is_block(x - 1, y, z):
		add_face(st, pos, Vector3.LEFT, block_id, block_rotation)

	if not is_block(x, y, z - 1):
		add_face(st, pos, Vector3.FORWARD, block_id, block_rotation)

	if not is_block(x, y, z + 1):
		add_face(st, pos, Vector3.BACK, block_id, block_rotation)


# Создание одной грани
func add_face(st: SurfaceTool, pos: Vector3, normal: Vector3, block_id: String, block_rotation: Vector3) -> void:

	var v: Array = []
	var uv_rotation_steps: int = 0  # 0,1,2,3 = 0°,90°,180°,270°

	# UV из атласа
	var atlas_pos: Vector2i

	match normal:
		Vector3.UP:
			v = [
				pos + Vector3(0,1,0),
				pos + Vector3(1,1,0),
				pos + Vector3(1,1,1),
				pos + Vector3(0,1,1)
			]
			atlas_pos = atlas_generator.block_uv_map[block_id][\"top\"]

		Vector3.DOWN:
			v = [
				pos + Vector3(0,0,0),
				pos + Vector3(0,0,1),
				pos + Vector3(1,0,1),
				pos + Vector3(1,0,0)
			]
			atlas_pos = atlas_generator.block_uv_map[block_id][\"bottom\"]

		Vector3.RIGHT:
			v = [
				pos + Vector3(1,0,0),
				pos + Vector3(1,0,1),
				pos + Vector3(1,1,1),
				pos + Vector3(1,1,0)
			]
			atlas_pos = atlas_generator.block_uv_map[block_id][\"side\"]
			uv_rotation_steps = 2

		Vector3.LEFT:
			v = [
				pos + Vector3(0,0,0),
				pos + Vector3(0,1,0),
				pos + Vector3(0,1,1),
				pos + Vector3(0,0,1)
			]
			atlas_pos = atlas_generator.block_uv_map[block_id][\"side\"]
			uv_rotation_steps = 1

		Vector3.FORWARD:
			v = [
				pos + Vector3(0,0,0),
				pos + Vector3(1,0,0),
				pos + Vector3(1,1,0),
				pos + Vector3(0,1,0)
			]
			atlas_pos = atlas_generator.block_uv_map[block_id][\"side\"]
			uv_rotation_steps = 2

		Vector3.BACK:
			v = [
				pos + Vector3(0,0,1),
				pos + Vector3(0,1,1),
				pos + Vector3(1,1,1),
				pos + Vector3(1,0,1)
			]
			atlas_pos = atlas_generator.block_uv_map[block_id][\"side\"]
			uv_rotation_steps = 1

	if atlas_generator.blocks[block_id][\"is_rotate\"] == true:
		if normal == block_rotation:
			atlas_pos = atlas_generator.block_uv_map[block_id][\"top\"]

		elif normal == -block_rotation:
			atlas_pos = atlas_generator.block_uv_map[block_id][\"bottom\"]

		else:
			atlas_pos = atlas_generator.block_uv_map[block_id][\"side\"]
			match block_rotation:
				Vector3.RIGHT:
					if normal == Vector3.FORWARD: uv_rotation_steps = 1
					elif normal == Vector3.BACK: uv_rotation_steps = 2
					elif normal == Vector3.DOWN: uv_rotation_steps = 2
					elif normal == Vector3.UP: uv_rotation_steps = 1

				Vector3.LEFT:
					if normal == Vector3.FORWARD: uv_rotation_steps = 3
					elif normal == Vector3.BACK: uv_rotation_steps = 4
					elif normal == Vector3.RIGHT: uv_rotation_steps = 2
					elif normal == Vector3.UP: uv_rotation_steps = 3

				Vector3.FORWARD:
					if normal == Vector3.RIGHT: uv_rotation_steps = 3
					elif normal == Vector3.LEFT: uv_rotation_steps = 4
					elif normal == Vector3.BACK: uv_rotation_steps = 2
					elif normal == Vector3.DOWN: uv_rotation_steps = 3

				Vector3.BACK:
					if normal == Vector3.RIGHT: uv_rotation_steps = 1
					elif normal == Vector3.LEFT: uv_rotation_steps = 2
					elif normal == Vector3.DOWN: uv_rotation_steps = 1
					elif normal == Vector3.UP: uv_rotation_steps = 2
	else:
		block_rotation = Vector3.UP

	var TILE_SIZE: float = atlas_generator.TILE_SIZE

	var uv_origin: Vector2 = Vector2(atlas_pos.x, atlas_pos.y) * TILE_SIZE

	var uv00: Vector2 = uv_origin
	var uv10: Vector2 = uv_origin + Vector2(TILE_SIZE, 0)
	var uv11: Vector2 = uv_origin + Vector2(TILE_SIZE, TILE_SIZE)
	var uv01: Vector2 = uv_origin + Vector2(0, TILE_SIZE)

	for i: int in range(uv_rotation_steps):
		var temp: Vector2 = uv00
		uv00 = uv01
		uv01 = uv11
		uv11 = uv10
		uv10 = temp

	# Треугольник 1
	st.set_normal(normal)
	st.set_uv(uv00)
	st.add_vertex(v[0])

	st.set_normal(normal)
	st.set_uv(uv10)
	st.add_vertex(v[1])

	st.set_normal(normal)
	st.set_uv(uv11)
	st.add_vertex(v[2])

	# Треугольник 2
	st.set_normal(normal)
	st.set_uv(uv00)
	st.add_vertex(v[0])

	st.set_normal(normal)
	st.set_uv(uv11)
	st.add_vertex(v[2])

	st.set_normal(normal)
	st.set_uv(uv01)
	st.add_vertex(v[3])


## Установка блока
@rpc(\"any_peer\", \"reliable\")
func place_block(hit_position: Vector3, normal: Vector3, block_id: String = \"grass_block\", player_rotation: Vector3 = Vector3.ZERO) -> void:
	var local_pos: Vector3 = to_local(hit_position + normal * 0.5)

	var x: int = int(floor(local_pos.x))
	var y: int = int(floor(local_pos.y))
	var z: int = int(floor(local_pos.z))

	# блок попадает внутрь текущего чанка?
	if x >= 0 and y >= 0 and z >= 0 and \\
		x < CHUNK_SIZE and y < CHUNK_SIZE and z < CHUNK_SIZE:
		
		if atlas_generator.blocks[block_id][\"type\"] == \"model\":
			blocks[x][y][z] = {
				\"id\": block_id,
				\"rotation\": player_rotation
			}
		else:
			blocks[x][y][z] = {
				\"id\": block_id,
				\"rotation\": normal
			}
		if not(multiplayer.is_server()):
			rebuild()
	# блок вне текущего чанка (в соседнем)
	else:
		var neighbor_chunk_pos: Vector3 = position + normal * CHUNK_SIZE
		var chunk_name: String = 'chunk_' + str(int(neighbor_chunk_pos.x / CHUNK_SIZE)) + \\
						 '_' + str(int(neighbor_chunk_pos.y / CHUNK_SIZE)) + \\
						 '_' + str(int(neighbor_chunk_pos.z / CHUNK_SIZE))
		# Поиск соседнего чанка
		var chunk: Node = get_parent().get_node(chunk_name)
		# Соседнего чанка нет?
		if chunk == null:
			chunk = load(\"res://Scenes/MapSystem/chunk.tscn\").instantiate()
			chunk.position = neighbor_chunk_pos
			chunk.name = chunk_name
			get_parent().add_child(chunk)
			var neighbor_local_pos: Vector3 = chunk.to_local(hit_position + normal * 0.5)
			var nx: int = int(floor(neighbor_local_pos.x))
			var ny: int = int(floor(neighbor_local_pos.y))
			var nz: int = int(floor(neighbor_local_pos.z))
			#var nx: int = x
			#var ny: int = y
			#var nz: int = z
			#print(nx, ny, nz)
			#nx = clamp(abs(nx), 0, CHUNK_SIZE - 1)
			#ny = clamp(abs(ny), 0, CHUNK_SIZE - 1)
			#nz = clamp(abs(nz), 0, CHUNK_SIZE - 1)
			#print(nx, ny, nz)
			chunk.generate_blocks()
			if atlas_generator.blocks[block_id][\"type\"] == \"model\":
				chunk.blocks[nx][ny][nz] = {
					\"id\": block_id,
					\"rotation\": player_rotation
				}
			else:
				chunk.blocks[nx][ny][nz] = {
					\"id\": block_id,
					\"rotation\": normal
				}
				
			if not(multiplayer.is_server()):
				chunk.rebuild()
		# Соседний чанк существует
		else:
			var neighbor_local_pos: Vector3 = chunk.to_local(hit_position + normal * 0.5)
			var nx: int = floor(neighbor_local_pos.x)
			var ny: int = floor(neighbor_local_pos.y)
			var nz: int = floor(neighbor_local_pos.z)
			#nx = clamp(nx, 0, CHUNK_SIZE - 1)
			#ny = clamp(ny, 0, CHUNK_SIZE - 1)
			#nz = clamp(nz, 0, CHUNK_SIZE - 1)
			if atlas_generator.blocks[block_id][\"type\"] == \"model\":
				chunk.blocks[nx][ny][nz] = {
					\"id\": block_id,
					\"rotation\": player_rotation
				}
			else:
				chunk.blocks[nx][ny][nz] = {
					\"id\": block_id,
					\"rotation\": normal
				}
			if not(multiplayer.is_server()):
				chunk.rebuild()

## Ломание блока
@rpc(\"any_peer\", \"reliable\")
func break_block(hit_position: Vector3, normal: Vector3) -> void:
	var local_pos: Vector3 = to_local(hit_position - normal * 0.01)

	var x: int = int(floor(local_pos.x))
	var y: int = int(floor(local_pos.y))
	var z: int = int(floor(local_pos.z))

	if x >= 0 and y >= 0 and z >= 0 and \\
		x < CHUNK_SIZE and y < CHUNK_SIZE and z < CHUNK_SIZE:
		blocks[x][y][z] = {
			\"id\": \"air\",
			\"rotation\": Vector3.ZERO
		}
		if not(multiplayer.is_server()):
			rebuild()















