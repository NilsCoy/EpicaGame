[gd_scene format=3 uid="uid://b2doj54r58x6h"]

[sub_resource type="GDScript" id="GDScript_58wgy"]
script/source = "extends Node

@onready var chunks: Node = $Chunks
@onready var entities: Node = $Entities
@onready var players: Node = $Players

func _ready() -> void:
	load_entities()
	load_chunks()

func load_entities() -> void:
	var files: Array = SaveSystem.get_files_in_directory('World/entities')
	if files != []:
		for file: String in files:
			var path: String = 'World/entities/'+file
			var data: Dictionary = SaveSystem.read_json(SaveSystem.get_file_path(path, true))
			var entity_scene: Resource = load(\"res://Scenes/Entities/{type}.tscn\".format({\"type\": data.type}))
			var entity: Node = SaveSystem.load_file(path, entity_scene)
			entities.add_child(entity)

func load_chunks() -> void:
	var chunk_scene: Resource = preload(\"res://Scenes/MapSystem/chunk.tscn\")
	var files: Array = SaveSystem.get_files_in_directory('World/chunks')
	if files != []:
		for file: String in files:
			var chunk: Node3D
			chunk = SaveSystem.load_file('World/chunks/'+file, chunk_scene)
			chunks.add_child(chunk)
	else:
		var chunk: Node3D
		chunk = chunk_scene.instantiate()
		chunk.name = 'chunk_0_0_0'
		chunk.starter_block = true
		chunks.add_child(chunk)

#func _input(event: InputEvent) -> void:
	#if Input.is_action_just_pressed('fast_save'):
		#for chunk: Node in chunks.get_children():
			#if 'chunk' in chunk.name:
				#SaveSystem.save_file('World/chunks/'+chunk.name+'.json', chunk)

func save() -> void:
	for chunk: Node in chunks.get_children():
		SaveSystem.save_file('World/chunks/'+chunk.name+'.json', chunk)
	for entity: Node in entities.get_children():
		SaveSystem.save_file('World/entities/'+entity.name+'.json', entity)
	for player: Node in players.get_children():
		SaveSystem.save_file('World/players/'+player.name+'.json', player)
	
"

