[sub_resource type="GDScript" id="GDScript_58wgy"]
script/source = "extends Node

## Узел карты: хранит чанки, сущности и игроков.
## Загрузкой чанков вокруг игрока занимается дочерний узел ChunkLoader.

signal load_completed_signal

var _initial_ready: bool = false
var _waiting_players: Array = []

@onready var chunks: Node = $Chunks
@onready var entities: Node = $Entities
@onready var players: Node = $Players
@onready var spawn: Node3D = $Spawn

@rpc('authority', 'reliable')
func add_player(pocket: Array) -> void:
	if not _initial_ready:
		_waiting_players.append(pocket)
		return
	_spawn_player(pocket)

func _spawn_player(pocket: Array) -> void:
	var scene: Resource = load('res://Scenes/Entities/player.tscn')
	var decompressed: PackedByteArray = pocket[0].decompress_dynamic(-1, FileAccess.COMPRESSION_GZIP)
	var data: Dictionary = bytes_to_var(decompressed)
	var player: Node3D = scene.instantiate()
	player.load_data(data)
	player.player_id = data.get('player_id', 1)
	player.set_multiplayer_authority(player.player_id)
	players.add_child(player)

@rpc('authority', 'reliable')
func load_completed(expected: int, center: Vector2i) -> void:
	$ChunkLoader.begin_initial_load(expected, center)
	#$AmbientSystem.init_sound()

@rpc('any_peer', 'reliable')
func load_scene() -> void:
	if multiplayer.is_server():
		var sender: int = multiplayer.get_remote_sender_id()
		var center: Vector2i = $ChunkLoader.get_spawn_column()
		var sent: int = $ChunkLoader.send_spawn_chunks(sender, center)
		for player: Node in players.get_children():
			rpc_id(sender, 'add_player', [player.serialize()])
		rpc_id(sender, 'load_completed', sent, center)

func _ready() -> void:
	MultiplayerManager.map = self
	MultiplayerManager.players = $Players
	MultiplayerManager.player_spawn = $Spawn
	$ChunkLoader.initial_chunks_ready.connect(_on_initial_chunks_ready)
	if OS.has_feature('dedicated_server'):
		update_spawn()
		load_entities()
		load_chunks()

func _on_initial_chunks_ready() -> void:
	_initial_ready = true
	for pocket: Array in _waiting_players:
		_spawn_player(pocket)
	_waiting_players.clear()
	emit_signal('load_completed_signal')

func load_entities() -> void:
	var files: Array = FileManager.get_files_in_directory('./world/entities')
	if files != []:
		for file: String in files:
			var path: String = './world/entities/'+file
			var data: Dictionary = FileManager.read_json(FileManager.get_file_path(path, true))
			var entity_scene: Resource = load('res://Scenes/Entities/{type}.tscn'.format({'type': data.type}))
			var entity: Node = FileManager.load_file(path, entity_scene)
			entities.add_child(entity)

func load_chunks() -> void:
	var chunk_scene: Resource = load('res://Scenes/MapSystem/chunk.tscn')
	var files: Array = FileManager.get_files_in_directory('./world/chunks')
	if files != []:
		for file: String in files:
			var chunk: Node3D
			chunk = FileManager.load_file('./world/chunks/'+file, chunk_scene)
			chunks.add_child(chunk)
	else:
		var chunk: Node3D
		chunk = chunk_scene.instantiate()
		chunk.name = 'chunk_0_0_0'
		chunk.starter_block = true
		chunks.add_child(chunk)

func save() -> void:
	for chunk: Node in chunks.get_children():
		FileManager.save_file('./world/chunks/'+chunk.name+'.json', chunk)
	for entity: Node in entities.get_children():
		FileManager.save_file('./world/entities/'+entity.name+'.json', entity)
	for player: Node in players.get_children():
		FileManager.save_file('./world/players/'+player.name+'.json', player)

func rebuild_chunks() -> void:
	for chunk: Node in chunks.get_children():
		chunk.rebuild()

func update_spawn() -> void:
	spawn.position = Vector3(
		Settings.world['settings']['spawn_position'][0],
		Settings.world['settings']['spawn_position'][1],
		Settings.world['settings']['spawn_position'][2]
		)
	spawn.rotation = Vector3(
		Settings.world['settings']['spawn_rotation'][0],
		Settings.world['settings']['spawn_rotation'][1],
		Settings.world['settings']['spawn_rotation'][2]
		)
"

