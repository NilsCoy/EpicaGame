[sub_resource type="GDScript" id="GDScript_58wgy"]
script/source = "extends Node3D

var chunk_scene := preload(\"res://Scenes/chunk.tscn\")
var chunk: Node3D

func _ready():
	chunk = $SaveSystem.load_file(chunk_scene, self)
	if chunk == null:
		chunk = chunk_scene.instantiate()
		chunk.starter_block = true
	add_child(chunk)

func _input(event):
	if Input.is_action_just_pressed('fast_save'):
		$SaveSystem.save_file(chunk)
"

