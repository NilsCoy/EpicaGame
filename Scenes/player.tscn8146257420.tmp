[sub_resource type="GDScript" id="GDScript_f60y1"]
script/source = "extends CharacterBody3D

# Move
const SPEED: float = 5.0
const JUMP_VELOCITY: float = 4.5
var FLY_SPEED: float = 5.0

# Player settings
@export_range(0, 2, 1) var gamemode: int = 1 # 0=spectator, 1=survival, 2=creative
@export_range(0, 2, 1) var move_state: int = 1 # 0=crawl, 1=walk, 2=run
var fly = true

# Utils
var curr_block: String = \"\"

@onready var inventory = $UI/Inventory
@onready var camera = $Model/Camera
@onready var animation = $AnimationTree

func _ready() -> void:
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	$UI/HUD/ItemName.text = str(curr_block)

func _physics_process(delta) -> void:
	$UI/HUD/FPS.text = str(int(Performance.get_monitor(Performance.TIME_FPS)))

	if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
		_move(delta)
	
	_animatins()

func _input(event) -> void:
	_ui(event)

func _get_rotation_from_forward(forward: Vector3) -> Vector3:
	if abs(forward.x) > abs(forward.z):
		return Vector3.RIGHT if forward.x > 0 else Vector3.LEFT
	else:
		return Vector3.BACK if forward.z > 0 else Vector3.FORWARD

func _place_block() -> void:
	var forward = -camera.global_transform.basis.z
	forward.y = 0
	forward = forward.normalized()
	var rot = _get_rotation_from_forward(forward)
	
	var space_state = get_world_3d().direct_space_state
	
	var from = camera.global_transform.origin
	var to = from + camera.global_transform.basis.z * -6.0
	
	var query = PhysicsRayQueryParameters3D.create(from, to)
	query.set_collision_mask(2)
	var result = space_state.intersect_ray(query)
	
	if result:
		var chunk = result.collider.get_parent()
		if chunk.has_method(\"place_block\"):
			chunk.place_block(result.position, result.normal, curr_block, rot)

func _break_block() -> void:
	var space_state = get_world_3d().direct_space_state
	
	var from = camera.global_transform.origin
	var to = from + camera.global_transform.basis.z * -6.0
	
	var query = PhysicsRayQueryParameters3D.create(from, to)
	query.set_collision_mask(2)
	var result = space_state.intersect_ray(query)

	if result:
		var chunk = result.collider.get_parent()
		if chunk.has_method(\"break_block\"):
			chunk.break_block(result.position, result.normal)


func _move(delta) -> void:
	match gamemode:
		0: _spectator_move(delta)
		1: _survival_move(delta)
		2: _creative_move(delta)

	var input_dir = Input.get_vector(\"left\", \"right\", \"up\", \"down\")
	var direction = (transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()
	direction = direction.rotated(Vector3.UP, camera.global_rotation.y)
	if direction:
		velocity.x = direction.x * FLY_SPEED
		velocity.z = direction.z * FLY_SPEED
	else:
		velocity.x = move_toward(velocity.x, 0, FLY_SPEED)
		velocity.z = move_toward(velocity.z, 0, FLY_SPEED)

	move_and_slide()

func _ui(e) -> void:
	if Input.is_action_just_pressed(\"esc\"):
		if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
			Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
		else: Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	
	if Input.is_action_just_pressed(\"tab\"):
		if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
			Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
			$UI/Inventory/ScrollContainer.show()
		else:
			Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
			$UI/Inventory/ScrollContainer.hide()

	if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
		if fly:
			_fly_speed(e)

		if gamemode == 0: # spectator
			for i in range(10):
				if Input.is_action_just_pressed(str(i)):
					if inventory.hot_bar_data.slot_datas[i-1]:
						if inventory.hot_bar_data.slot_datas[i-1].item_data.attributes.has(\"action\"):
							if inventory.hot_bar_data.slot_datas[i-1].item_data.attributes[\"action\"] == \"block\":
								curr_block = inventory.hot_bar_data.slot_datas[i-1].item_data.name
					else: curr_block = \"\"
					$UI/HUD/ItemName.text = str(curr_block)
					break

			if e is InputEventMouseButton and e.pressed:
				if e.button_index == MOUSE_BUTTON_LEFT:
					_break_block()
				elif e.button_index == MOUSE_BUTTON_RIGHT and curr_block != \"\":
					_place_block()

func _fly_speed(e) -> void:
	if e is InputEventMouseButton:
		if e.button_index == MOUSE_BUTTON_WHEEL_UP and FLY_SPEED < 50.0:
			FLY_SPEED += 0.5
		elif e.button_index == MOUSE_BUTTON_WHEEL_DOWN and FLY_SPEED > 5.0:
			FLY_SPEED -= 0.5

func _spectator_move(delta) -> void:
	# There is no gravity
	if Input.is_action_pressed(\"space\"):
		velocity.y = FLY_SPEED
	elif Input.is_action_pressed(\"shift\"):
		velocity.y = -FLY_SPEED
	else:
		velocity.y = 0

func _survival_move(delta) -> void:
	# Add the gravity
	if not is_on_floor():
		velocity += get_gravity() * delta

	# Add the jump
	if Input.is_action_just_pressed(\"space\") and is_on_floor():
		velocity.y = JUMP_VELOCITY

func _creative_move(delta) -> void:
	var fly_switch_timer = $FlySwitchTimer
	if Input.is_action_just_pressed(\"space\"):
		if fly_switch_timer.is_stopped(): fly_switch_timer.start()
		else: fly = not(fly)
	if fly: _spectator_move(delta)
	else: _survival_move(delta)

func switch_gamemode(to_gamemode: int) -> void:
	gamemode = to_gamemode
	if to_gamemode == 0:
		$Model.switch_camera(1)
		$CollisionShape3D.disabled = true
	else:
		$Model.switch_camera(3)
		$CollisionShape3D.disabled = false

func _animatins():
	if velocity:
		animation[\"parameters/pos_state/transition_request\"] = \"walk\"
	else:
		animation[\"parameters/pos_state/transition_request\"] = \"idle\"
"

