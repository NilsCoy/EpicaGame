[gd_scene format=3 uid="uid://bj6pnxogxt38v"]

[sub_resource type="GDScript" id="GDScript_oax4l"]
script/source = "extends Node

@export var ROOT := true

func get_files_in_directory(path: String) -> Array:
	var files = []
	var dir = DirAccess.open(get_file_path(path))
	if dir:
		dir.list_dir_begin()
		var file_name = dir.get_next()
		while file_name != \"\":
			if not dir.current_is_dir():  # Проверяем, что это файл, а не папка
				files.append(file_name)
			file_name = dir.get_next()
		dir.list_dir_end()
	else:
		print(\"Ошибка открытия директории: \", path)
	return files

func get_file_path(path: String):
	if ROOT: return 'res://' + path
	else: return 'user://' + path

func save_file(path, node: Node) -> void:
	var json_string = JSON.stringify(node.save_data())  # превращаем словарь в строку JSON
	var file = FileAccess.open(get_file_path(path), FileAccess.WRITE)
	if file:
		file.store_string(json_string)
		file.close()
		print(\"Safe node!\")

func load_file(path, scene: PackedScene) -> Node:
	if not FileAccess.file_exists(get_file_path(path)):
		return null

	var file = FileAccess.open(get_file_path(path), FileAccess.READ)
	if file:
		var json_string = file.get_as_text()
		file.close()

		var result = JSON.parse_string(json_string)
		var node = scene.instantiate()
		node.load_data(result)
		print(\"Load node!\")
		return node

	return null
"

