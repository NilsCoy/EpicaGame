script/source = "extends CharacterBody3D


const SPEED = 5.0
const JUMP_VELOCITY = 4.5

@onready var model = $model

func _ready():
	print(model.get_children())
	for i in model.get_children():
		if i.name == 'AnimationPlayer':
			var anim_player = i as AnimationPlayer
			var animation = anim_player.get_animation(\"test\")
			animation.loop_mode = Animation.LOOP_LINEAR
			anim_player.play('test')
		if i.name == 'basis':
			var mesh_instance = i.get_children()[0].get_children()[0]
			var material
			material = mesh_instance.mesh.surface_get_material(0)
			material.albedo_color = Color(\"#f4d5bb\")
			mesh_instance.set_surface_override_material(0, material)
			
			material = mesh_instance.mesh.surface_get_material(1)
			material.albedo_color = Color(\"000000ff\")
			mesh_instance.set_surface_override_material(1, material)
			
			material = mesh_instance.mesh.surface_get_material(2)
			material.albedo_color = Color(\"ffffffff\")
			mesh_instance.set_surface_override_material(2, material)
			
			material = mesh_instance.mesh.surface_get_material(3)
			material.albedo_color = Color(\"1a0c03ff\")
			mesh_instance.set_surface_override_material(3, material)

