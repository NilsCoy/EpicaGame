[sub_resource type="GDScript" id="GDScript_erv1k"]
script/source = "extends Control

@onready var username: LineEdit = $GridContainer/UsernameEdit

func _ready() -> void:
	if not(OS.has_feature(\"dedicated_server\")):
		multiplayer.connected_to_server.connect(_on_connected)
		multiplayer.connection_failed.connect(_on_failed)
	else:
		hide()

func _on_connected() -> void:
	hide()
func _on_failed() -> void:
	get_parent().loading.visible = false

func _on_connect_button_pressed() -> void:
	if username.text != '':
		if username.text.strip_edges() != '':
			if MultiplayerManager.get_connect() != 'connected' or MultiplayerManager.get_connect() != 'connection':
				get_parent().loading.visible = true
				MultiplayerManager.create_client()

func _on_server_button_pressed() -> void:
	MultiplayerManager.create_server()

@rpc(\"authority\")
func register_player() -> void:
	MultiplayerManager.map.load_completed_signal.connect(world_loaded)

func world_loaded() -> void:
	MultiplayerManager.rpc_id(1, \"create_player\", multiplayer.get_unique_id(), username.text)
	get_parent().loading.visible = false
	print(\"Map loaded\")

func _on_username_edit_text_changed(new_text: String) -> void:
	var regex: RegEx = RegEx.new()
	regex.compile(\"^[a-zA-Z0-9_]*$\")
	if regex.search(new_text) == null and new_text != \"\":
		var clean_text: String = \"\"
		var allowed_regex: RegEx = RegEx.new()
		allowed_regex.compile(\"[^a-zA-Z0-9_]\")
		clean_text = allowed_regex.sub(new_text, \"\", true)
		username.text = clean_text
		username.caret_column = clean_text.length()
"

