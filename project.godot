; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Skalm"
run/main_scene="uid://cp0u50t6q8pqi"
config/use_custom_user_dir=true
config/custom_user_dir_name="Skalm"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="uid://dqrxvtevt23vi"

[autoload]

FileManager="*uid://nsupueetcdkv"
Settings="*uid://dfojuqvoeaykl"
Global="*uid://37ngxtvnw0do"
ChatManager="*uid://48u6r55dqft0"
ConsoleManager="*uid://betlpu28upd4t"
ItemRegistry="*res://Scripts/Globals/Items/ItemRegistry.gd"
SaveManager="*res://Scripts/Globals/SaveManager.gd"
InventoryNetwork="*res://Scripts/Globals/Items/InventoryNetwork.gd"
MultiplayerManager="*uid://bvr1gyml37fhx"
WorldEdit="*uid://dygalja6l12lh"
BlockRegistry="*uid://dbun2jd5jkdkj"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2

[display]

window/size/mode=2

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg", "res://addons/sky_3d/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "green",
"res://Resources/": "teal",
"res://Scenes/": "red",
"res://Scripts/": "purple",
"res://addons/": "gray",
"res://defaults/": "gray"
}

[global_group]

Players=""

[gui]

timers/tooltip_delay_sec=0.1
theme/custom_font="uid://dn5jgsvkxh1p"

[importer_defaults]

texture={
"compress/channel_pack": 0,
"compress/hdr_compression": 1,
"compress/high_quality": false,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"compress/rdo_quality_loss": 0.0,
"compress/uastc_level": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false,
"mipmaps/limit": -1,
"process/channel_remap/alpha": 3,
"process/channel_remap/blue": 2,
"process/channel_remap/green": 1,
"process/channel_remap/red": 0,
"process/fix_alpha_border": true,
"process/hdr_as_srgb": false,
"process/hdr_clamp_exposure": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"process/size_limit": 0,
"roughness/mode": 0,
"roughness/src_normal": ""
}

